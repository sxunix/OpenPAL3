// PAL3 in-game status indicator (top-right HUD), declarative-UI port.
//
// Mirrors `UISceneFace` (gameui/uisceneface.cpp): a 71x90 window hung off
// the screen's right edge, 5px down, holding the `bk.tga` ring, the
// controlled hero's avatar (`face<role>/face00..02.tga`, normal / hover /
// click) and two `UIProgressBar`s — 精 on `mp.tga`, 神 on `hp.tga`.
// The engine blits a UI picture 1:1 from its texture's bottom-left corner
// (bk.tga's art is exactly the 71x90 bottom-left of a 128x128 page), so
// every piece here is drawn as that crop, scaled uniformly with the panel.
//
// The avatar is tinted by the walking poison (`CB_COLOR_*`) and darkened
// when 精 drops under a quarter. Clicking it shows the click variant for
// 0.8s, then opens the full-screen character-status (状态) menu, delegated
// to `state_menu.paint_state_menu`; it closes on its exit button or an
// outside click. The agent server can also drive it via `set_menu_open`.

import radiance;
import scripting_services;
import shared.openpal3;
import radiance_scripting.ui as gui;
// Full-screen character-status (状态) overlay, popped on avatar click.
import yaobow.openpal3.state_menu as state_menu;
// System (系统) menu — save/load/exit, opened from the state menu toolbar.
import yaobow.openpal3.system_menu as system_menu;
// 道具 page, opened from the same toolbar.
import yaobow.openpal3.item_menu as item_menu;
// 装备 page, likewise.
import yaobow.openpal3.equip_menu as equip_menu;
// 仙术 page, likewise.
import yaobow.openpal3.magic_menu as magic_menu;
// 御剑 page, likewise.
import yaobow.openpal3.sword_menu as sword_menu;
// 阵法 page, likewise.
import yaobow.openpal3.lineup_menu as lineup_menu;
// 侠义榜, likewise.
import yaobow.openpal3.justicebook_menu as book_menu;

// HUD scale: the 128px of the old full-page layout spans this fraction of
// the framebuffer height (kept from the previous tuning, so the dial keeps
// its size on screen).
let ST_SCALE_FACTOR: float = 0.22 / 128.0;
// `UISceneFace::Create`, in window pixels.
let ST_BK_W: float = 71.0;
let ST_BK_H: float = 90.0;
let ST_TOP: float = 5.0;
let ST_FACE_X: float = 15.0;
let ST_FACE_Y: float = 4.0;
let ST_FACE_SIZE: float = 64.0;
// The bars' `ProgressRc` for `m_radius` 2 (`UIProgressBar::Render`, LEFT):
// left+2, top+1 .. bottom-2, at most right-2.
// 精: window (2,1) 50x43.
let ST_JING_X: float = 4.0;
let ST_JING_Y: float = 2.0;
let ST_JING_W: float = 46.0;
let ST_JING_H: float = 40.0;
// 神: window (4,48) 43x34.
let ST_SHEN_X: float = 6.0;
let ST_SHEN_Y: float = 49.0;
let ST_SHEN_W: float = 39.0;
let ST_SHEN_H: float = 31.0;
// `UIProgressBar::Update`: m_speed 1 * 36 px per second.
let ST_BAR_SPEED: float = 36.0;
// `UISceneFace::Update`: the click variant shows this long before the menu.
let ST_CLICK_DELAY: float = 0.8;

// `CB_COLOR_*` (combat/cbdefine.h), indexed by `poison_kind`:
// 0 风 1 雷 2 水 3 火 4 土. Wind 0xFF52B66B, thunder 0xFFA466EA, water
// 0xFF399AAD, fire 0xFFDE7531, earth 0xFFD6AE5A, split into R/G/B.
let POISON_R: array<int> = [82, 164, 57, 222, 214];
let POISON_G: array<int> = [182, 102, 154, 117, 174];
let POISON_B: array<int> = [107, 234, 173, 49, 90];

let FACE_DIR: array<string> = ["face0/", "face1/", "face2/", "face3/", "face4/"];
let FACE_ROOT: string = "/basedata/basedata/ui/scene/face/";

pub struct[openpal3.IPal3StatusRenderer] Pal3StatusRendererImpl(
    pub sprites: box<scripting_services.ISpriteService>,
    // In-game menu (state) atlas: resolves `ui/gamemainui/*` sprites.
    pub atlas: box<openpal3.IPal3UiAtlas>,
    // PAL3 service, for the system menu's save/load/exit actions.
    pub pal3: box<openpal3.IPal3Service>,
    pub bk: ?box<scripting_services.ISprite>,
    pub hp: ?box<scripting_services.ISprite>,
    pub mp: ?box<scripting_services.ISprite>,
    // Avatars of all five heroes, `role * 3 + variant` (0 normal, 1 hover,
    // 2 click). Loaded up front: `load_sprite` can't run mid-frame (the
    // texture cache is borrowed while the HUD paints).
    pub faces: array<?box<scripting_services.ISprite>>,
    // Whether the full-screen character-status menu is open.
    pub menu_open: bool = false,
    // Previous-frame left-button state, for click rising-edge detection.
    pub prev_down: bool = false,
    // System-menu page (-1 closed; see system_menu.paint_system_menu).
    pub sys_mode: int = -1,
    // 道具 page state (-1 closed; otherwise item_menu's packed state).
    pub prop_state: int = -1,
    // 装备 page state (-1 closed; otherwise equip_menu's packed state).
    pub equip_state: int = -1,
    // 仙术 page state (-1 closed; otherwise magic_menu's packed state).
    pub magic_state: int = -1,
    // 御剑 page state (-1 closed; otherwise sword_menu's packed state).
    pub sword_state: int = -1,
    // 阵法 page state (-1 closed; 0 open — the page keeps no state of
    // its own, the formation lives in the save).
    pub array_state: int = -1,
    // 侠义榜 state (-1 closed; otherwise the book's packed state).
    pub book_state: int = -1,
    // The bars' current `m_progress`, in window pixels.
    pub jing_px: float = 0.0,
    pub shen_px: float = 0.0,
    // Seconds since the avatar was clicked; -1 when not clicked.
    pub click_time: float = -1.0,
) {
    pub fn render_status(self: refmut<Self>, ui: box<radiance.IUiHost>, dt: float) -> int {
        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }

        let s = lh * ST_SCALE_FACTOR;
        let x0 = lw - ST_BK_W * s;
        let y0 = ST_TOP * s;

        // `SetFacePic(PlayerMgr::m_underctrl)`.
        let role = self.pal3.controlled_role();

        let pmx = ui.mouse_pos_x();
        let pmy = ui.mouse_pos_y();
        let down = ui.mouse_down(0);
        // Rising edge: pressed this frame but not last.
        let click = down && !self.prev_down;
        let fx0 = x0 + ST_FACE_X * s;
        let fy0 = y0 + ST_FACE_Y * s;
        let over = pmx >= fx0 && pmx <= fx0 + ST_FACE_SIZE * s
            && pmy >= fy0 && pmy <= fy0 + ST_FACE_SIZE * s;
        let was_open = self.menu_open;

        // 精 (stat 3/4) and 神 (stat 7/8) of the controlled hero; the bars
        // walk toward their target at 36 px/s.
        let jing = self.pal3.role_stat(role, 3);
        let jing_max = self.pal3.role_stat(role, 4);
        let shen = self.pal3.role_stat(role, 7);
        let shen_max = self.pal3.role_stat(role, 8);
        self.jing_px = bar_step(self.jing_px, bar_target(jing, jing_max, ST_JING_W), dt);
        self.shen_px = bar_step(self.shen_px, bar_target(shen, shen_max, ST_SHEN_W), dt);

        // Avatar colour: poison tint, then near-death darkening on 精.
        let mut r = 255;
        let mut g = 255;
        let mut b = 255;
        let poison = self.pal3.poison_kind();
        if poison >= 0 && poison < 5 {
            r = POISON_R[poison];
            g = POISON_G[poison];
            b = POISON_B[poison];
        }
        if jing_max > 0 && jing * 100 / jing_max < 25 {
            r = r / 4;
            g = g / 5;
            b = b / 5;
        }

        // Variant: click (for 0.8s after the press) > hover > normal.
        let mut variant = 0;
        if self.click_time >= 0.0 {
            variant = 2;
        } else if over {
            variant = 1;
        }
        let face = self.faces[role * 3 + variant];

        // Draw the HUD dial first so the full-screen menu (drawn below)
        // composites OVER it — the menu owns the screen while open. Order
        // is `UISceneFace`'s child order: bk, face, 精, 神.
        blit_crop(ui, self.bk, x0, y0, s, 0.0, 0.0, ST_BK_W, ST_BK_H, 255, 255, 255);
        blit_crop(ui, face, x0, y0, s, ST_FACE_X, ST_FACE_Y, ST_FACE_SIZE, ST_FACE_SIZE, r, g, b);
        blit_crop(ui, self.hp, x0, y0, s, ST_JING_X, ST_JING_Y, floor(self.jing_px), ST_JING_H,
            255, 255, 255);
        blit_crop(ui, self.mp, x0, y0, s, ST_SHEN_X, ST_SHEN_Y, floor(self.shen_px), ST_SHEN_H,
            255, 255, 255);

        // The full-screen menus, painted on top of the HUD. The system
        // menu (save/load/exit) replaces the state menu when the toolbar's
        // System button switches to it.
        // 存盘点（物件 0x2a）要打开存档：整个菜单换成系统页的「储存」。
        if self.pal3.take_save_point_request() {
            self.menu_open = false;
            self.prop_state = -1;
            self.equip_state = -1;
            self.magic_state = -1;
            self.array_state = -1;
            self.sword_state = -1;
            self.book_state = -1;
            self.sys_mode = 1;
        }
        let sys_was_open = self.sys_mode >= 0;
        let prop_was_open = self.prop_state >= 0;
        let equip_was_open = self.equip_state >= 0;
        let magic_was_open = self.magic_state >= 0;
        let sword_was_open = self.sword_state >= 0;
        let array_was_open = self.array_state >= 0;
        let book_was_open = self.book_state >= 0;
        if book_was_open {
            let r = book_menu.paint_justicebook_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.book_state);
            if r == book_menu.TO_STATE {
                self.book_state = -1;
                self.menu_open = true;
            } else if r == book_menu.TO_PROP {
                self.book_state = -1;
                self.prop_state = 0;
            } else if r == book_menu.TO_EQUIP {
                self.book_state = -1;
                self.equip_state = 0;
            } else if r == book_menu.TO_MAGIC {
                self.book_state = -1;
                self.magic_state = 0;
            } else if r == book_menu.TO_SWORD {
                self.book_state = -1;
                self.sword_state = 0;
            } else if r == book_menu.TO_ARRAY {
                self.book_state = -1;
                self.array_state = 0;
            } else if r == book_menu.TO_SYSTEM {
                self.book_state = -1;
                self.sys_mode = 0;
            } else if r == book_menu.CLOSE {
                self.book_state = -1;
            } else {
                self.book_state = r;
            }
        } else if array_was_open {
            let r = lineup_menu.paint_lineup_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.array_state);
            if r == lineup_menu.TO_STATE {
                self.array_state = -1;
                self.menu_open = true;
            } else if r == lineup_menu.TO_PROP {
                self.array_state = -1;
                self.prop_state = 0;
            } else if r == lineup_menu.TO_EQUIP {
                self.array_state = -1;
                self.equip_state = 0;
            } else if r == lineup_menu.TO_MAGIC {
                self.array_state = -1;
                self.magic_state = 0;
            } else if r == lineup_menu.TO_SWORD {
                self.array_state = -1;
                self.sword_state = 0;
            } else if r == lineup_menu.TO_BOOK {
                self.array_state = -1;
                self.book_state = 0;
            } else if r == lineup_menu.TO_SYSTEM {
                self.array_state = -1;
                self.sys_mode = 0;
            } else if r == lineup_menu.CLOSE {
                self.array_state = -1;
            } else {
                self.array_state = r;
            }
        } else if sword_was_open {
            let r = sword_menu.paint_sword_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.sword_state);
            if r == sword_menu.TO_STATE {
                self.sword_state = -1;
                self.menu_open = true;
            } else if r == sword_menu.TO_PROP {
                self.sword_state = -1;
                self.prop_state = 0;
            } else if r == sword_menu.TO_EQUIP {
                self.sword_state = -1;
                self.equip_state = 0;
            } else if r == sword_menu.TO_MAGIC {
                self.sword_state = -1;
                self.magic_state = 0;
            } else if r == sword_menu.TO_ARRAY {
                self.sword_state = -1;
                self.array_state = 0;
            } else if r == sword_menu.TO_BOOK {
                self.sword_state = -1;
                self.book_state = 0;
            } else if r == sword_menu.TO_SYSTEM {
                self.sword_state = -1;
                self.sys_mode = 0;
            } else if r == sword_menu.CLOSE {
                self.sword_state = -1;
            } else {
                self.sword_state = r;
            }
        } else if magic_was_open {
            let r = magic_menu.paint_magic_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.magic_state);
            if r == magic_menu.TO_STATE {
                self.magic_state = -1;
                self.menu_open = true;
            } else if r == magic_menu.TO_PROP {
                self.magic_state = -1;
                self.prop_state = 0;
            } else if r == magic_menu.TO_EQUIP {
                self.magic_state = -1;
                self.equip_state = 0;
            } else if r == magic_menu.TO_SWORD {
                self.magic_state = -1;
                self.sword_state = 0;
            } else if r == magic_menu.TO_ARRAY {
                self.magic_state = -1;
                self.array_state = 0;
            } else if r == magic_menu.TO_BOOK {
                self.magic_state = -1;
                self.book_state = 0;
            } else if r == magic_menu.TO_SYSTEM {
                self.magic_state = -1;
                self.sys_mode = 0;
            } else if r == magic_menu.CLOSE {
                self.magic_state = -1;
            } else {
                self.magic_state = r;
            }
        } else if equip_was_open {
            let r = equip_menu.paint_equip_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.equip_state);
            if r == equip_menu.TO_STATE {
                self.equip_state = -1;
                self.menu_open = true;
            } else if r == equip_menu.TO_PROP {
                self.equip_state = -1;
                self.prop_state = 0;
            } else if r == equip_menu.TO_MAGIC {
                self.equip_state = -1;
                self.magic_state = 0;
            } else if r == equip_menu.TO_SWORD {
                self.equip_state = -1;
                self.sword_state = 0;
            } else if r == equip_menu.TO_ARRAY {
                self.equip_state = -1;
                self.array_state = 0;
            } else if r == equip_menu.TO_BOOK {
                self.equip_state = -1;
                self.book_state = 0;
            } else if r == equip_menu.TO_SYSTEM {
                self.equip_state = -1;
                self.sys_mode = 0;
            } else if r == equip_menu.CLOSE {
                self.equip_state = -1;
            } else {
                self.equip_state = r;
            }
        } else if sys_was_open {
            self.sys_mode = system_menu.paint_system_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.sys_mode);
        } else if prop_was_open {
            let r = item_menu.paint_item_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.prop_state);
            if r == item_menu.TO_STATE {
                self.prop_state = -1;
                self.menu_open = true;
            } else if r == item_menu.TO_EQUIP {
                self.prop_state = -1;
                self.equip_state = 0;
            } else if r == item_menu.TO_MAGIC {
                self.prop_state = -1;
                self.magic_state = 0;
            } else if r == item_menu.TO_SWORD {
                self.prop_state = -1;
                self.sword_state = 0;
            } else if r == item_menu.TO_ARRAY {
                self.prop_state = -1;
                self.array_state = 0;
            } else if r == item_menu.TO_BOOK {
                self.prop_state = -1;
                self.book_state = 0;
            } else if r == item_menu.TO_SYSTEM {
                self.prop_state = -1;
                self.sys_mode = 0;
            } else if r == item_menu.CLOSE {
                self.prop_state = -1;
            } else {
                self.prop_state = r;
            }
        } else if was_open {
            let r = state_menu.paint_state_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click);
            if r == 2 {
                self.menu_open = false;
                self.sys_mode = 0;
            } else if r == 3 {
                self.menu_open = false;
                self.prop_state = 0;
            } else if r == 4 {
                self.menu_open = false;
                self.equip_state = 0;
            } else if r == 5 {
                self.menu_open = false;
                self.magic_state = 0;
            } else if r == 6 {
                self.menu_open = false;
                self.sword_state = 0;
            } else if r == 7 {
                self.menu_open = false;
                self.array_state = 0;
            } else if r == 8 {
                self.menu_open = false;
                self.book_state = 0;
            } else {
                self.menu_open = r == 1;
            }
        }

        // Avatar click: hold the click variant 0.8s, then open the menu
        // (only when nothing was open, so the menu's own outside-click
        // dismissal isn't instantly undone).
        let any_open = was_open || sys_was_open || prop_was_open || equip_was_open
            || magic_was_open || sword_was_open || array_was_open || book_was_open;
        if self.click_time >= 0.0 {
            self.click_time = self.click_time + dt;
            if self.click_time > ST_CLICK_DELAY {
                self.click_time = -1.0;
                if !self.is_menu_open() { self.menu_open = true; }
            }
        } else if !any_open && over && click {
            self.click_time = 0.0;
        }
        self.prev_down = down;
        // 系统页关着就把存盘点给的「能存」收回。
        if self.sys_mode < 0 { self.pal3.leave_save_point(); }
        0
    }

    // Agent-server hook: open/close the character-status menu without a
    // synthetic avatar click. Takes effect on the next idle frame.
    pub fn set_menu_open(self: refmut<Self>, open: bool) -> int {
        self.menu_open = open;
        if !open {
            // 关就是整个全屏菜单都关。`set_menu_page` 开的道具 / 系统等页各有自己
            // 的状态，只清 `menu_open` 的话 `is_menu_open` 还是真、那一页照画——
            // 回放里关完系统页，系统页一直挂在画面上。
            self.prop_state = -1;
            self.equip_state = -1;
            self.magic_state = -1;
            self.array_state = -1;
            self.sword_state = -1;
            self.book_state = -1;
            self.sys_mode = -1;
        }
        0
    }

    // Open one page directly. `page` is the toolbar index (`menu_chrome.PAGE_*`):
    // 0 状态 · 1 道具 · 2 装备 · 3 仙术 · 4 阵法 · 5 御剑 · 6 侠义榜 · 7 系统.
    pub fn set_menu_page(self: refmut<Self>, page: int) -> int {
        self.menu_open = page == 0;
        self.prop_state = if page == 1 { 0 } else { -1 };
        self.equip_state = if page == 2 { 0 } else { -1 };
        self.magic_state = if page == 3 { 0 } else { -1 };
        self.array_state = if page == 4 { 0 } else { -1 };
        self.sword_state = if page == 5 { 0 } else { -1 };
        self.book_state = if page == 6 { 0 } else { -1 };
        self.sys_mode = if page == 7 { 0 } else { -1 };
        0
    }

    // Whether the character-status menu is open. The adventure director
    // polls this each frame to freeze the game world while it's up.
    pub fn is_menu_open(self: refmut<Self>) -> bool {
        return self.menu_open || self.sys_mode >= 0 || self.prop_state >= 0
            || self.equip_state >= 0 || self.magic_state >= 0 || self.sword_state >= 0
            || self.array_state >= 0 || self.book_state >= 0;
    }
}

// `UIProgressBar::SetProgress`: the bar length for `cur` of `max`.
fn bar_target(cur: int, max: int, len: float) -> float {
    if max <= 0 { return 0.0; }
    let mut t = (cur as float) * len / (max as float);
    if t < 0.0 { t = 0.0; }
    if t > len { t = len; }
    return t;
}

// `UIProgressBar::Update`: move `cur` toward `target` by 36 px/s.
fn bar_step(cur: float, target: float, dt: float) -> float {
    let d = ST_BAR_SPEED * dt;
    if cur < target {
        if cur + d >= target { return target; }
        return cur + d;
    }
    if cur > target {
        if cur - d <= target { return target; }
        return cur - d;
    }
    return cur;
}

// `ProgressRc.right` is a RECT long: whole pixels. (p7 has no float->int
// cast; the bars are under 50px, so count up.)
fn floor(v: float) -> float {
    let mut n = 0.0;
    while n + 1.0 <= v { n = n + 1.0; }
    return n;
}

// A UI picture as the engine blits it: the `w`x`h` texels at the bottom-left
// of the texture, 1:1, at window pixel (`px`, `py`) of the panel at
// (`x0`, `y0`) scaled by `s`, multiplied by colour `r,g,b` (0..255).
fn blit_crop(
    ui: box<radiance.IUiHost>, sp: ?box<scripting_services.ISprite>,
    x0: float, y0: float, s: float,
    px: float, py: float, w: float, h: float,
    r: int, g: int, b: int,
) -> int {
    if w <= 0.0 || h <= 0.0 { return 0; }
    if sp == null { return 0; }
    let t = sp!;
    let tw = t.width() as float;
    let th = t.height() as float;
    if tw <= 0.0 || th <= 0.0 { return 0; }
    let du = t.u1() - t.u0();
    let dv = t.v1() - t.v0();
    let u1 = t.u0() + du * (w / tw);
    let v0 = t.v0() + dv * ((th - h) / th);
    let sx = x0 + px * s;
    let sy = y0 + py * s;
    ui.image_rect_tinted(t.com_id(), sx, sy, sx + w * s, sy + h * s,
        t.u0(), v0, u1, t.v1(),
        (r as float) / 255.0, (g as float) / 255.0, (b as float) / 255.0, 1.0);
    0
}

pub fn make_pal3_status_renderer(
    sprites: box<scripting_services.ISpriteService>,
    atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
) -> box<openpal3.IPal3StatusRenderer> {
    let bk = sprites.load_sprite(FACE_ROOT + "bk.tga");
    // `hp` is the 精 bar (mp.tga), `mp` the 神 bar (hp.tga) — the original's
    // names for the two pictures are swapped against what they show.
    let hp = sprites.load_sprite(FACE_ROOT + "mp.tga");
    let mp = sprites.load_sprite(FACE_ROOT + "hp.tga");
    // `face<role>/face0<variant>.tga` (`SetFacePic`'s "face%d\\face%02d").
    let mut faces: array<?box<scripting_services.ISprite>> = [];
    for role in Range(0, 5) {
        let dir = FACE_ROOT + FACE_DIR[role];
        faces.push(sprites.load_sprite(dir + "face00.tga"));
        faces.push(sprites.load_sprite(dir + "face01.tga"));
        faces.push(sprites.load_sprite(dir + "face02.tga"));
    }
    return box(Pal3StatusRendererImpl(sprites, atlas, pal3, bk, hp, mp, faces,
        false, false, -1));
}
