// PAL3 in-game status indicator (top-right HUD), declarative-UI port.
//
// Owns all of its state in p7: it `load_sprite`s the `ui/scene/face`
// panel art once (`bk.tga` background ring, `hp.tga`/`mp.tga` gauges, and
// the team-lead avatar `face0` normal/hover/click variants) and holds the
// handles for its lifetime so the textures stay uploaded. The SCE command
// loop forwards a per-frame `render_status` call only while the player has
// control (no SCE running).
//
// HP/MP render full (no HP/MP state exists yet). The avatar swaps variant
// on mouse-over (hover) / mouse-down (click). Clicking the avatar opens
// the full-screen character-status (状态) menu, delegated to
// `state_menu.paint_state_menu`; it closes on its exit button or an
// outside click. The agent server can also drive it via `set_menu_open`.

import radiance;
import scripting_services;
import shared.openpal3;
import radiance_scripting.ui as gui;
// Full-screen character-status (状态) overlay, popped on avatar click.
import yaobow.openpal3.state_menu as state_menu;
// System (系统) menu — save/load/exit, opened from the state menu toolbar.
import yaobow.openpal3.system_menu as system_menu;
// 道具 page, opened from the same toolbar.
import yaobow.openpal3.item_menu as item_menu;
// 装备 page, likewise.
import yaobow.openpal3.equip_menu as equip_menu;
// 仙术 page, likewise.
import yaobow.openpal3.magic_menu as magic_menu;
// 御剑 page, likewise.
import yaobow.openpal3.sword_menu as sword_menu;
// 阵法 page, likewise.
import yaobow.openpal3.lineup_menu as lineup_menu;
// 侠义榜, likewise.
import yaobow.openpal3.justicebook_menu as book_menu;

// Panel size as a fraction of framebuffer height. bk.tga is 128x128; the
// whole HUD is scaled uniformly so its on-screen height = lh * this.
let ST_PANEL_HEIGHT_FACTOR: float = 0.22;
// bk.tga has fully-transparent padding (57px right, 38px top). To snap the
// visible dial flush to the screen's right edge we shift right by that pad;
// to control the top gap we cancel the top pad and add a small native gap.
let ST_BK_RIGHT_PAD: float = 57.0;
let ST_BK_TOP_PAD: float   = 38.0;
let ST_TOP_GAP_PX: float   = 6.0;

// --- Native-pixel layout (relative to bk's top-left corner, 128px canvas) ---
// Each element is positioned + sized in bk's native pixels; the whole panel
// is scaled by (panel / BK_SIZE) to actual screen pixels. Tune these freely.
let ST_BK_SIZE: float    = 128.0;
let ST_AVATAR_X: float   = 16.0;
let ST_AVATAR_Y: float   = 42.0;
let ST_AVATAR_W: float   = 64.0;
let ST_AVATAR_H: float   = 64.0;
let ST_HP_X: float       = 5.0;
let ST_HP_Y: float       = 17.0;
let ST_HP_W: float       = 64.0;
let ST_HP_H: float       = 64.0;
let ST_MP_X: float       = 6.0;
let ST_MP_Y: float       = 54.0;
let ST_MP_W: float       = 64.0;
let ST_MP_H: float       = 64.0;

pub struct[openpal3.IPal3StatusRenderer] Pal3StatusRendererImpl(
    pub sprites: box<scripting_services.ISpriteService>,
    // In-game menu (state) atlas: resolves `ui/gamemainui/*` sprites.
    pub atlas: box<openpal3.IPal3UiAtlas>,
    // PAL3 service, for the system menu's save/load/exit actions.
    pub pal3: box<openpal3.IPal3Service>,
    pub bk: ?box<scripting_services.ISprite>,
    pub hp: ?box<scripting_services.ISprite>,
    pub mp: ?box<scripting_services.ISprite>,
    // Team-lead avatar variants: 0 normal, 1 hover, 2 click.
    pub face_n: ?box<scripting_services.ISprite>,
    pub face_h: ?box<scripting_services.ISprite>,
    pub face_c: ?box<scripting_services.ISprite>,
    // Whether the full-screen character-status menu is open.
    pub menu_open: bool = false,
    // Previous-frame left-button state, for click rising-edge detection.
    pub prev_down: bool = false,
    // System-menu page (-1 closed; see system_menu.paint_system_menu).
    pub sys_mode: int = -1,
    // 道具 page state (-1 closed; otherwise item_menu's packed state).
    pub prop_state: int = -1,
    // 装备 page state (-1 closed; otherwise equip_menu's packed state).
    pub equip_state: int = -1,
    // 仙术 page state (-1 closed; otherwise magic_menu's packed state).
    pub magic_state: int = -1,
    // 御剑 page state (-1 closed; otherwise sword_menu's packed state).
    pub sword_state: int = -1,
    // 阵法 page state (-1 closed; 0 open — the page keeps no state of
    // its own, the formation lives in the save).
    pub array_state: int = -1,
    // 侠义榜 state (-1 closed; otherwise the book's packed state).
    pub book_state: int = -1,
) {
    pub fn render_status(self: refmut<Self>, ui: box<radiance.IUiHost>, dt: float) -> int {
        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }

        let panel = lh * ST_PANEL_HEIGHT_FACTOR;
        let s = panel / ST_BK_SIZE;
        // Hang bk's transparent right pad off-screen so the dial is flush
        // right; cancel its top pad and leave a small native top gap.
        let x1 = lw + ST_BK_RIGHT_PAD * s;
        let x0 = x1 - panel;
        let y0 = (ST_TOP_GAP_PX - ST_BK_TOP_PAD) * s;
        let y1 = y0 + panel;

        // Each element is laid out in native px relative to bk's top-left
        // corner (x0, y0), then scaled by `s`.
        let ax0 = x0 + ST_AVATAR_X * s;
        let ay0 = y0 + ST_AVATAR_Y * s;
        let ax1 = ax0 + ST_AVATAR_W * s;
        let ay1 = ay0 + ST_AVATAR_H * s;
        let hx0 = x0 + ST_HP_X * s;
        let hy0 = y0 + ST_HP_Y * s;
        let hx1 = hx0 + ST_HP_W * s;
        let hy1 = hy0 + ST_HP_H * s;
        let mx0 = x0 + ST_MP_X * s;
        let my0 = y0 + ST_MP_Y * s;
        let mx1 = mx0 + ST_MP_W * s;
        let my1 = my0 + ST_MP_H * s;

        let pmx = ui.mouse_pos_x();
        let pmy = ui.mouse_pos_y();
        let down = ui.mouse_down(0);
        // Rising edge: pressed this frame but not last.
        let click = down && !self.prev_down;
        let over = pmx >= x0 && pmx <= x1 && pmy >= y0 && pmy <= y1;
        let was_open = self.menu_open;

        // Decorative variant: click (mouse down over panel) > hover > normal.
        let mut face = self.face_n;
        if over {
            if down { face = self.face_c; } else { face = self.face_h; }
        }

        // Draw the HUD dial first so the full-screen menu (drawn below)
        // composites OVER it — the menu owns the screen while open.
        let items: array<box<gui.Element>> = [
            sprite_rect(self.bk, x0, y0, x1, y1),
            sprite_rect(face, ax0, ay0, ax1, ay1),
            sprite_rect(self.hp, hx0, hy0, hx1, hy1),
            sprite_rect(self.mp, mx0, my0, mx1, my1),
        ];
        let root = gui.Stack(items);
        gui.paint_root(root, ui, gui.make_ctx());

        // The full-screen menus, painted on top of the HUD. The system
        // menu (save/load/exit) replaces the state menu when the toolbar's
        // System button switches to it.
        let sys_was_open = self.sys_mode >= 0;
        let prop_was_open = self.prop_state >= 0;
        let equip_was_open = self.equip_state >= 0;
        let magic_was_open = self.magic_state >= 0;
        let sword_was_open = self.sword_state >= 0;
        let array_was_open = self.array_state >= 0;
        let book_was_open = self.book_state >= 0;
        if book_was_open {
            let r = book_menu.paint_justicebook_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.book_state);
            if r == book_menu.TO_STATE {
                self.book_state = -1;
                self.menu_open = true;
            } else if r == book_menu.TO_PROP {
                self.book_state = -1;
                self.prop_state = 0;
            } else if r == book_menu.TO_EQUIP {
                self.book_state = -1;
                self.equip_state = 0;
            } else if r == book_menu.TO_MAGIC {
                self.book_state = -1;
                self.magic_state = 0;
            } else if r == book_menu.TO_SWORD {
                self.book_state = -1;
                self.sword_state = 0;
            } else if r == book_menu.TO_ARRAY {
                self.book_state = -1;
                self.array_state = 0;
            } else if r == book_menu.TO_SYSTEM {
                self.book_state = -1;
                self.sys_mode = 0;
            } else if r == book_menu.CLOSE {
                self.book_state = -1;
            } else {
                self.book_state = r;
            }
        } else if array_was_open {
            let r = lineup_menu.paint_lineup_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.array_state);
            if r == lineup_menu.TO_STATE {
                self.array_state = -1;
                self.menu_open = true;
            } else if r == lineup_menu.TO_PROP {
                self.array_state = -1;
                self.prop_state = 0;
            } else if r == lineup_menu.TO_EQUIP {
                self.array_state = -1;
                self.equip_state = 0;
            } else if r == lineup_menu.TO_MAGIC {
                self.array_state = -1;
                self.magic_state = 0;
            } else if r == lineup_menu.TO_SWORD {
                self.array_state = -1;
                self.sword_state = 0;
            } else if r == lineup_menu.TO_BOOK {
                self.array_state = -1;
                self.book_state = 0;
            } else if r == lineup_menu.TO_SYSTEM {
                self.array_state = -1;
                self.sys_mode = 0;
            } else if r == lineup_menu.CLOSE {
                self.array_state = -1;
            } else {
                self.array_state = r;
            }
        } else if sword_was_open {
            let r = sword_menu.paint_sword_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.sword_state);
            if r == sword_menu.TO_STATE {
                self.sword_state = -1;
                self.menu_open = true;
            } else if r == sword_menu.TO_PROP {
                self.sword_state = -1;
                self.prop_state = 0;
            } else if r == sword_menu.TO_EQUIP {
                self.sword_state = -1;
                self.equip_state = 0;
            } else if r == sword_menu.TO_MAGIC {
                self.sword_state = -1;
                self.magic_state = 0;
            } else if r == sword_menu.TO_ARRAY {
                self.sword_state = -1;
                self.array_state = 0;
            } else if r == sword_menu.TO_BOOK {
                self.sword_state = -1;
                self.book_state = 0;
            } else if r == sword_menu.TO_SYSTEM {
                self.sword_state = -1;
                self.sys_mode = 0;
            } else if r == sword_menu.CLOSE {
                self.sword_state = -1;
            } else {
                self.sword_state = r;
            }
        } else if magic_was_open {
            let r = magic_menu.paint_magic_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.magic_state);
            if r == magic_menu.TO_STATE {
                self.magic_state = -1;
                self.menu_open = true;
            } else if r == magic_menu.TO_PROP {
                self.magic_state = -1;
                self.prop_state = 0;
            } else if r == magic_menu.TO_EQUIP {
                self.magic_state = -1;
                self.equip_state = 0;
            } else if r == magic_menu.TO_SWORD {
                self.magic_state = -1;
                self.sword_state = 0;
            } else if r == magic_menu.TO_ARRAY {
                self.magic_state = -1;
                self.array_state = 0;
            } else if r == magic_menu.TO_BOOK {
                self.magic_state = -1;
                self.book_state = 0;
            } else if r == magic_menu.TO_SYSTEM {
                self.magic_state = -1;
                self.sys_mode = 0;
            } else if r == magic_menu.CLOSE {
                self.magic_state = -1;
            } else {
                self.magic_state = r;
            }
        } else if equip_was_open {
            let r = equip_menu.paint_equip_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.equip_state);
            if r == equip_menu.TO_STATE {
                self.equip_state = -1;
                self.menu_open = true;
            } else if r == equip_menu.TO_PROP {
                self.equip_state = -1;
                self.prop_state = 0;
            } else if r == equip_menu.TO_MAGIC {
                self.equip_state = -1;
                self.magic_state = 0;
            } else if r == equip_menu.TO_SWORD {
                self.equip_state = -1;
                self.sword_state = 0;
            } else if r == equip_menu.TO_ARRAY {
                self.equip_state = -1;
                self.array_state = 0;
            } else if r == equip_menu.TO_BOOK {
                self.equip_state = -1;
                self.book_state = 0;
            } else if r == equip_menu.TO_SYSTEM {
                self.equip_state = -1;
                self.sys_mode = 0;
            } else if r == equip_menu.CLOSE {
                self.equip_state = -1;
            } else {
                self.equip_state = r;
            }
        } else if sys_was_open {
            self.sys_mode = system_menu.paint_system_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.sys_mode);
        } else if prop_was_open {
            let r = item_menu.paint_item_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click, self.prop_state);
            if r == item_menu.TO_STATE {
                self.prop_state = -1;
                self.menu_open = true;
            } else if r == item_menu.TO_EQUIP {
                self.prop_state = -1;
                self.equip_state = 0;
            } else if r == item_menu.TO_MAGIC {
                self.prop_state = -1;
                self.magic_state = 0;
            } else if r == item_menu.TO_SWORD {
                self.prop_state = -1;
                self.sword_state = 0;
            } else if r == item_menu.TO_ARRAY {
                self.prop_state = -1;
                self.array_state = 0;
            } else if r == item_menu.TO_BOOK {
                self.prop_state = -1;
                self.book_state = 0;
            } else if r == item_menu.TO_SYSTEM {
                self.prop_state = -1;
                self.sys_mode = 0;
            } else if r == item_menu.CLOSE {
                self.prop_state = -1;
            } else {
                self.prop_state = r;
            }
        } else if was_open {
            let r = state_menu.paint_state_menu(
                ui, self.atlas, self.pal3, pmx, pmy, down, click);
            if r == 2 {
                self.menu_open = false;
                self.sys_mode = 0;
            } else if r == 3 {
                self.menu_open = false;
                self.prop_state = 0;
            } else if r == 4 {
                self.menu_open = false;
                self.equip_state = 0;
            } else if r == 5 {
                self.menu_open = false;
                self.magic_state = 0;
            } else if r == 6 {
                self.menu_open = false;
                self.sword_state = 0;
            } else if r == 7 {
                self.menu_open = false;
                self.array_state = 0;
            } else if r == 8 {
                self.menu_open = false;
                self.book_state = 0;
            } else {
                self.menu_open = r == 1;
            }
        }

        // Avatar click opens the menu (only when it wasn't already open, so
        // the menu's own outside-click dismissal isn't instantly undone).
        if !was_open && !sys_was_open && !prop_was_open && !equip_was_open && !magic_was_open
            && !sword_was_open && !array_was_open && !book_was_open && over && click {
            self.menu_open = true;
        }
        self.prev_down = down;
        0
    }

    // Agent-server hook: open/close the character-status menu without a
    // synthetic avatar click. Takes effect on the next idle frame.
    pub fn set_menu_open(self: refmut<Self>, open: bool) -> int {
        self.menu_open = open;
        0
    }

    // Open one page directly. `page` is the toolbar index (`menu_chrome.PAGE_*`):
    // 0 状态 · 1 道具 · 2 装备 · 3 仙术 · 4 阵法 · 5 御剑 · 6 侠义榜 · 7 系统.
    pub fn set_menu_page(self: refmut<Self>, page: int) -> int {
        self.menu_open = page == 0;
        self.prop_state = if page == 1 { 0 } else { -1 };
        self.equip_state = if page == 2 { 0 } else { -1 };
        self.magic_state = if page == 3 { 0 } else { -1 };
        self.array_state = if page == 4 { 0 } else { -1 };
        self.sword_state = if page == 5 { 0 } else { -1 };
        self.book_state = if page == 6 { 0 } else { -1 };
        self.sys_mode = if page == 7 { 0 } else { -1 };
        0
    }

    // Whether the character-status menu is open. The adventure director
    // polls this each frame to freeze the game world while it's up.
    pub fn is_menu_open(self: refmut<Self>) -> bool {
        return self.menu_open || self.sys_mode >= 0 || self.prop_state >= 0
            || self.equip_state >= 0 || self.magic_state >= 0 || self.sword_state >= 0
            || self.array_state >= 0 || self.book_state >= 0;
    }
}

// Place a sprite in the rect `(x0, y0)-(x1, y1)`. The screen-local
// `SpriteRect` element this used to wrap is gone — `gui.Sprite` is the shared
// widget for "blit an `ISprite` into the rect the parent assigns", and it is
// null-safe, so the caller no longer needs its own guard.
fn sprite_rect(
    s: ?box<scripting_services.ISprite>,
    x0: float, y0: float, x1: float, y1: float,
) -> box<gui.Element> {
    return gui.Positioned(x0, y0, x1 - x0, y1 - y0, gui.Sprite(s));
}

pub fn make_pal3_status_renderer(
    sprites: box<scripting_services.ISpriteService>,
    atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
) -> box<openpal3.IPal3StatusRenderer> {
    let face = "/basedata/basedata/ui/scene/face/";
    let bk = sprites.load_sprite(face + "bk.tga");
    let hp = sprites.load_sprite(face + "mp.tga");
    let mp = sprites.load_sprite(face + "hp.tga");
    let face_n = sprites.load_sprite(face + "face0/face00.tga");
    let face_h = sprites.load_sprite(face + "face0/face01.tga");
    let face_c = sprites.load_sprite(face + "face0/face02.tga");
    return box(Pal3StatusRendererImpl(sprites, atlas, pal3, bk, hp, mp, face_n, face_h, face_c,
        false, false, -1));
}
