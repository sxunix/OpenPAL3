// PAL3 in-game dialog-box renderer (declarative-UI port).
//
// This renderer owns ALL of its state in p7. It is built with a generic,
// game-vfs-bound `ISpriteService` and `load_sprite`s its 9-slice chrome,
// bottom decoration and click-indicator frames once at construction,
// holding each `ISprite` handle for its lifetime (so the backing textures
// stay uploaded). The avatar portrait is loaded on demand from
// `set_avatar`; the curtain level and avatar side are plain fields.
//
// The Rust SCE command loop forwards events (`set_avatar` /
// `clear_avatar` / `set_curtain`) and the per-frame `render_dialog` /
// `render_curtain` draw calls — the exact points the legacy Rust
// `DialogBox::draw` / `fade_window` ran.
//
// The chrome, portrait, page indicator and deco are a `gui.Element` tree
// (`gui.Stack` of `gui.Positioned` sprites) painted via `gui.paint_root`;
// the text is then flowed onto it page by page (`flow_page`), and the SCE
// `Dlg` command calls `next_page` on each press before it closes the box.
// All geometry is the original `UIRoleDialog` layout (see the constants).
// A negative-width `gui.Positioned` reproduces the left-portrait mirror.

import radiance;
import scripting_services;
import shared.openpal3;
// Declarative widget lib. Aliased to `gui` so it doesn't collide with
// the `ui: IUiHost` render parameter.
import radiance_scripting.ui as gui;

// Geometry from the original `UIRoleDialog` / `UITextArea` (source in
// basedata.cpk: gameui/uiroledialog.cpp, gameui/UITextArea.cpp,
// gameui/uigamefrm.cpp), in its 800x600 screen units. The canvas is scaled
// by height into a centred 4:3 region, like every other PAL3 screen.
// [移植]
let CANVAS_W: float = 800.0;
let CANVAS_H: float = 600.0;

// Box (`m_roledlg.Create`: rc.bottom 600 - 150, clipped to bottom 594).
let BOX_TOP: float = 450.0;
let BOX_BOTTOM: float = 594.0;

// Portrait, 256x512 standing on the screen bottom; the left one is
// mirrored (`STATIC_LEFT_FLIP`) so the face looks inward.
let FACE_W: float = 256.0;
let FACE_H: float = 512.0;

// Text rect: 16 below the box top, 120 tall; 480 wide beside a portrait,
// 720 without one (`SetFace`).
let TEXT_TOP: float = 466.0;
let TEXT_H: float = 120.0;
let TEXT_LEFT_FACE_LEFT: float = 276.0;
let TEXT_LEFT_FACE_RIGHT: float = 22.0;
let TEXT_LEFT_NO_FACE: float = 36.0;
let TEXT_W_FACE: float = 480.0;
// The same widths in half-cell (10px) columns.
let TEXT_COLS_FACE: int = 48;
let TEXT_COLS_NO_FACE: int = 72;

// `GB_FONT_UNICODE20`: 20px cells, an ASCII byte one half-cell column, a
// GBK character two; lines 20 + 2 apart. A line that would cross the rect
// bottom starts the next page.
let FONT_CELL: float = 20.0;
let LINE_PITCH: float = 22.0;
// Pixel size handed to the bundled face so its ideographs (0.634 of the
// size) fill a 20px cell the way the original bitmap font did, and the lift
// that puts that ink inside the cell. [近似]
let FONT_PX: float = 30.0;
let FONT_LIFT: float = 5.0;

// Page indicator, 32x32 (`GetIconRect`); the deco strip under the box
// (`m_timeclose`, 134x20 centred on the bottom edge).
let ICON_Y: float = 552.0;
let ICON_SIZE: float = 32.0;
let ICON_X_RIGHT: float = 760.0;
let DECO_W: float = 134.0;
let DECO_H: float = 20.0;

pub struct[openpal3.IPal3DialogRenderer] Pal3DialogRendererImpl(
    pub sprites: box<scripting_services.ISpriteService>,
    // 9-slice chrome, by role (held for lifetime). null when missing.
    pub tl: ?box<scripting_services.ISprite>,
    pub bl: ?box<scripting_services.ISprite>,
    pub br: ?box<scripting_services.ISprite>,
    pub tr: ?box<scripting_services.ISprite>,
    pub left: ?box<scripting_services.ISprite>,
    pub bottom: ?box<scripting_services.ISprite>,
    pub right: ?box<scripting_services.ISprite>,
    pub top: ?box<scripting_services.ISprite>,
    pub center: ?box<scripting_services.ISprite>,
    pub deco: ?box<scripting_services.ISprite>,
    // Blinking page-advance indicator frames.
    pub page0: ?box<scripting_services.ISprite>,
    pub page1: ?box<scripting_services.ISprite>,
    // Avatar portrait (loaded on `set_avatar`) + side (0=left, 1=right).
    pub avatar: ?box<scripting_services.ISprite>,
    pub avatar_side: int,
    // Curtain/fade level in [-1, 1] and the indicator blink accumulator.
    pub curtain: float,
    pub indicator_t: float,
    // Paging: the text being shown, where the current page starts (char
    // index) and where it ended when last drawn.
    pub page_text: string,
    pub page_start: int,
    pub page_end: int,
) {
    pub fn set_avatar(self: refmut<Self>, role: string, face: string, side: int) -> int {
        let path = "/basedata/basedata/ROLE/" + role + "/" + face + ".tga";
        self.avatar = self.sprites.load_sprite(path);
        self.avatar_side = side;
        0
    }

    pub fn clear_avatar(self: refmut<Self>) -> int {
        self.avatar = null;
        0
    }

    pub fn set_curtain(self: refmut<Self>, value: float) -> int {
        self.curtain = value;
        0
    }

    pub fn render_dialog(
        self: refmut<Self>,
        ui: box<radiance.IUiHost>,
        text: string,
        dt: float,
    ) -> int {
        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }

        // 800x600 canvas -> screen: scale by height into a centred 4:3
        // region; narrower windows scale by width and sit on the bottom.
        let mut s = lh / CANVAS_H;
        let mut ox = (lw - CANVAS_W * s) / 2.0;
        let mut oy = 0.0;
        if lw / lh < CANVAS_W / CANVAS_H {
            s = lw / CANVAS_W;
            ox = 0.0;
            oy = lh - CANVAS_H * s;
        }

        if text != self.page_text {
            self.page_text = text;
            self.page_start = 0;
            self.page_end = 0;
        }

        let has_avatar = self.avatar != null;
        let avatar_at_right = self.avatar_side == 1;

        let mut text_left = TEXT_LEFT_NO_FACE;
        let mut text_cols = TEXT_COLS_NO_FACE;
        let mut icon_x = ICON_X_RIGHT;
        if has_avatar {
            text_cols = TEXT_COLS_FACE;
            if avatar_at_right {
                text_left = TEXT_LEFT_FACE_RIGHT;
                icon_x = TEXT_LEFT_FACE_RIGHT + TEXT_W_FACE + 4.0;
            } else {
                text_left = TEXT_LEFT_FACE_LEFT;
            }
        }

        // 9-slice chrome (`UIStaticFlex`): corner tiles are dlg0's width.
        let x0 = ox;
        let x1 = ox + CANVAS_W * s;
        let y0 = oy + BOX_TOP * s;
        let y1 = oy + BOX_BOTTOM * s;
        let tw = min_f(sprite_w(self.tl) * s, (x1 - x0) / 2.0);
        let th = min_f(sprite_w(self.tl) * s, (y1 - y0) / 2.0);

        // Blinking page indicator.
        self.indicator_t = self.indicator_t + dt;
        if self.indicator_t > 1.0 {
            self.indicator_t = 0.0;
        }
        let ind = if self.indicator_t > 0.5 { self.page0 } else { self.page1 };
        let ix = ox + icon_x * s;
        let iy = oy + ICON_Y * s;

        let dx = ox + (CANVAS_W - DECO_W) / 2.0 * s;
        let dy = oy + (CANVAS_H - DECO_H) * s;

        let items: array<box<gui.Element>> = [
            sprite_rect(self.tl, x0, y0, x0 + tw, y0 + th),
            sprite_rect(self.bl, x0, y1 - th, x0 + tw, y1),
            sprite_rect(self.br, x1 - tw, y1 - th, x1, y1),
            sprite_rect(self.tr, x1 - tw, y0, x1, y0 + th),
            sprite_rect(self.left, x0, y0 + th, x0 + tw, y1 - th),
            sprite_rect(self.bottom, x0 + tw, y1 - th, x1 - tw, y1),
            sprite_rect(self.right, x1 - tw, y0 + th, x1, y1 - th),
            sprite_rect(self.top, x0 + tw, y0, x1 - tw, y0 + th),
            sprite_rect(self.center, x0 + tw, y0 + th, x1 - tw, y1 - th),
            self.avatar_widget(ox, oy, s, has_avatar, avatar_at_right),
            sprite_rect(ind, ix, iy, ix + ICON_SIZE * s, iy + ICON_SIZE * s),
            sprite_rect(self.deco, dx, dy, dx + DECO_W * s, dy + DECO_H * s),
        ];
        let root = gui.Stack(items);
        gui.paint_root(root, ui, gui.make_ctx());

        self.page_end = flow_page(ui, text, self.page_start,
            ox + text_left * s, oy + TEXT_TOP * s, text_cols, s);
        0
    }

    // Turn to the next page of the current text. 1 when there was one,
    // 0 when the page on screen is the last (the dialog may close).
    pub fn next_page(self: refmut<Self>) -> int {
        if self.page_end > self.page_start && self.page_end < self.page_text.len_chars() {
            self.page_start = self.page_end;
            return 1;
        }
        0
    }

    // Portrait: 256x512 standing on the canvas bottom, on its side.
    // Mirrored on the left (a negative-width rect flips the blit).
    pub fn avatar_widget(
        self: refmut<Self>,
        ox: float, oy: float, s: float,
        has_avatar: bool, avatar_at_right: bool,
    ) -> box<gui.Element> {
        if !has_avatar {
            let empty: array<box<gui.Element>> = [];
            return gui.Stack(empty);
        }
        let top = oy + (CANVAS_H - FACE_H) * s;
        let bottom = oy + CANVAS_H * s;
        if !avatar_at_right {
            return sprite_rect(self.avatar, ox + FACE_W * s, top, ox, bottom);
        }
        let right = ox + CANVAS_W * s;
        return sprite_rect(self.avatar, right - FACE_W * s, top, right, bottom);
    }

    pub fn render_curtain(self: refmut<Self>, ui: box<radiance.IUiHost>) -> int {
        let c = self.curtain;
        if c == 0.0 { return 0; }

        let lw = ui.display_size_x() as float;
        let lh = ui.display_size_y() as float;
        if lw <= 0.0 || lh <= 0.0 { return 0; }

        // Magnitude is the fade opacity; sign selects the colour
        // (>= 0 fades to black, < 0 to white).
        let opacity = if c < 0.0 { 0.0 - c } else { c };
        let shade = if c < 0.0 { 1.0 } else { 0.0 };
        let root: box<gui.Element> = Curtain(shade, opacity);
        gui.paint_root(root, ui, gui.make_ctx());
        0
    }
}

// Build a `gui.Positioned` + `gui.Sprite` for the absolute rect
// `[x0,y0]`..`[x1,y1]`. A negative width/height (x1 < x0) flips the blit,
// reproducing the original mirrored-avatar draw. The sprite may be null
// (a piece that failed to load) — `gui.Sprite` then paints nothing, so a
// partial asset set degrades cleanly.
fn sprite_rect(
    s: ?box<scripting_services.ISprite>,
    x0: float, y0: float, x1: float, y1: float,
) -> box<gui.Element> {
    return gui.Positioned(x0, y0, x1 - x0, y1 - y0, gui.Sprite(s));
}

// Native pixel width of a (possibly null) sprite, as a float.
fn sprite_w(s: ?box<scripting_services.ISprite>) -> float {
    if s == null { return 0.0; }
    return s!.width() as float;
}

// ---------------------------------------------------------------------------
// Screen-local widget leaves (declarative `gui.Element` impls).
// ---------------------------------------------------------------------------

fn min_f(a: float, b: float) -> float {
    if a < b { a } else { b }
}

// Lay out and draw one page of dialog text starting at char `start`, the
// way `UITextArea::Draw` does: `\i` turns the colour to the highlight,
// `\r` back; a line wraps when the next character would cross the rect's
// right edge; the page ends at the line that would cross its bottom.
// Returns the char index the next page starts at (`len_chars` when the
// text is done). `x`/`y` is the rect's screen origin, `cols` its width in
// half-cell columns, `s` the canvas scale.
fn flow_page(
    ui: box<radiance.IUiHost>, text: string, start: int,
    x: float, y: float, cols: int, s: float,
) -> int {
    let size = FONT_PX * s;
    // `m_fontcolor` (255,250,250); `\i` is (5,255,255).
    let mut cr = 1.0;
    let mut cg = 250.0 / 255.0;
    let mut cb = 250.0 / 255.0;
    let mut col = 0;
    let mut line_y = 0.0;
    let n = text.len_chars();
    let mut i = start;
    while i < n {
        let oc = text.char_at(i);
        if oc == null { i = i + 1; continue; }
        let c = oc!;
        if c == "\\" {
            let on = text.char_at(i + 1);
            i = i + 2;
            if on == null { return n; }
            let e = on!;
            if e == "i" {
                cr = 5.0 / 255.0; cg = 1.0; cb = 1.0;
            } else if e == "r" {
                cr = 1.0; cg = 250.0 / 255.0; cb = 250.0 / 255.0;
            } else if e == "n" {
                line_y = line_y + LINE_PITCH;
                col = 0;
                if line_y + FONT_CELL > TEXT_H { return i; }
            }
            continue;
        }
        if c == "\n" {
            i = i + 1;
            line_y = line_y + LINE_PITCH;
            col = 0;
            if line_y + FONT_CELL > TEXT_H { return i; }
            continue;
        }
        let wc = if c.len_bytes() == 1 { 1 } else { 2 };
        if col + wc > cols {
            col = 0;
            line_y = line_y + LINE_PITCH;
        }
        if line_y + FONT_CELL > TEXT_H { return i; }
        ui.text_at_sized(x + (col as float) * (FONT_CELL / 2.0) * s,
                         y + (line_y - FONT_LIFT) * s, size,
                         cr, cg, cb, 1.0, c);
        col = col + wc;
        i = i + 1;
    }
    n
}

// Fullscreen fade curtain: a flat `(shade,shade,shade,opacity)` rect over
// the whole viewport. Replaces the legacy `render_curtain` `fill_rect`.
pub struct[gui.Element] Curtain(shade: float, opacity: float) {
    fn measure(self: ref<Self>, avail: gui.Size, ui: box<radiance.IUiHost>) -> gui.Size {
        return avail;
    }
    fn paint(self: ref<Self>, rect: gui.Rect,
             ui: box<radiance.IUiHost>, ctx: box<gui.UiCtx>) {
        ui.fill_rect(rect.x, rect.y, rect.right(), rect.bottom(),
                     self.shade, self.shade, self.shade, self.opacity);
    }
}

pub fn make_pal3_dialog_renderer(
    sprites: box<scripting_services.ISpriteService>,
) -> box<openpal3.IPal3DialogRenderer> {
    // Load the fixed chrome / indicator sprites once; each handle is
    // held by the renderer so its texture stays uploaded.
    let tl = sprites.load_sprite("/basedata/basedata/ui/flex/dlg0.tga");
    let bl = sprites.load_sprite("/basedata/basedata/ui/flex/dlg1.tga");
    let br = sprites.load_sprite("/basedata/basedata/ui/flex/dlg2.tga");
    let tr = sprites.load_sprite("/basedata/basedata/ui/flex/dlg3.tga");
    let left = sprites.load_sprite("/basedata/basedata/ui/flex/dlg4.tga");
    let bottom = sprites.load_sprite("/basedata/basedata/ui/flex/dlg5.tga");
    let right = sprites.load_sprite("/basedata/basedata/ui/flex/dlg6.tga");
    let top = sprites.load_sprite("/basedata/basedata/ui/flex/dlg7.tga");
    let center = sprites.load_sprite("/basedata/basedata/ui/flex/dlg8.tga");
    let deco = sprites.load_sprite("/basedata/basedata/ui/scene/timeclose.tga");
    let page0 = sprites.load_sprite("/basedata/basedata/ui/scene/page0.tga");
    let page1 = sprites.load_sprite("/basedata/basedata/ui/scene/page1.tga");

    return box(Pal3DialogRendererImpl(
        sprites,
        tl, bl, br, tr, left, bottom, right, top, center, deco,
        page0, page1,
        null, 0,
        0.0, 0.0,
        "", 0, 0,
    ));
}
