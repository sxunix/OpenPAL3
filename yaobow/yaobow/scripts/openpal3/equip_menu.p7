// PAL3 in-game 装备 (equipment) page — standalone overlay, reached from
// the 状态 or 道具 page's toolbar.
//
// Geometry from the original PAL3.exe (v1.4): page init `FUN_00496190`,
// tabs + list `FUN_00495ca0`, tab switch `FUN_00494d70`, top strip +
// attribute rows `FUN_00491f20`, the equip action `FUN_00469eb0`. Write-up
// in switch/re/notes/equip_page_layout.md; the shared list/scrollbar/
// toolbar machinery is documented with the 道具 page.
//
// A character wears SIX pieces: 武器 + 帽 + 衣 + 鞋 + 饰品 x2. The five
// horizontal rows are the non-weapon slots, the tall control on their left
// is the weapon.
//
// Deliberately not reproduced, and why:
//   * the 3D model preview in the Info panel,
//   * the attribute-comparison rows (the original shows how a highlighted
//     piece would change your stats; which four attributes map to its five
//     rows is still unresolved),
//   * `SelRole0..4`'s own art, which is not in `UI_opt.tli` — the
//     character plates down the right edge double as the selectors
//     instead, which is where the original puts them: its arrange
//     function `FUN_00494660` walks the party with exactly the state
//     page's base rect and 122 px step.

import radiance;
import shared.openpal3;
import radiance_scripting.ui as gui;
import yaobow.openpal3.menu_chrome as chrome;

// --- Sprites -------------------------------------------------------------
let SPR_FRAME: string     = "ui/GameMainUI/Equip/Frame.tga";
let SPR_INFO: string      = "ui/GameMainUI/Communal/Info.tga";
let SPR_WORD: string      = "ui/GameMainUI/Communal/Attack_word.tga";
let SPR_LISTFRAME: string = "ui/GameMainUI/Equip/ListFrame.tga";
let SPR_GRID: string      = "ui/GameMainUI/Equip/List_Grid.tga";
let SPR_SELECTED: string  = "ui/assistant/Communal/ListBoxSelPic.tga";
let SPR_SCROLL: string    = "ui/GameMainUI/Communal/Scroll/scrollbar";
let SPR_SORT: string      = "ui/GameMainUI/Communal/Sort";
let SPR_TAB: string       = "ui/GameMainUI/Equip/";
let SPR_WEAPON_CTRL: string = "ui/GameMainUI/Equip/Weapon_Ctrl";
let SPR_EQUIP_CTRL: string  = "ui/GameMainUI/Equip/Equip_Ctrl";
// Top strip, nine-sliced. The original steps each piece by the previous
// one's native width (0xf0 / 0xe / 0x100 in FUN_00491f20), so the pieces
// simply abut from x = 12.
let TOP_PIECES: array<string> = [
    "ui/GameMainUI/Communal/EquipTopFrame/TopFrameL.tga",
    "ui/GameMainUI/Communal/EquipTopFrame/TopFrameLM.tga",
    "ui/GameMainUI/Communal/EquipTopFrame/TopFrameM.tga",
    "ui/GameMainUI/Communal/PropTopFrame/TopFrameRM.tga",
    "ui/GameMainUI/Communal/EquipTopFrame/TopFrameR.tga",
];
let TOP_X: float = 12.0;
let TOP_Y: float = 0.0;

// --- Layout (native 800x600) ---------------------------------------------
let INFO_X: float = 10.0;  let INFO_Y: float = 125.0;
let WORD_X: float = 195.0; let WORD_Y: float = 141.0;
let LF_X: float = 251.0;   let LF_Y: float = 125.0;

// Five tabs, 42x50, y 123..173, spaced 24 (the last one 23).
let TAB_Y0: float = 123.0;
let TAB_W: float = 42.0;   let TAB_H: float = 50.0;
let TAB_X: array<float> = [266.0, 332.0, 398.0, 464.0, 529.0];
let TAB_BASE: array<string> = ["Weapon", "Cloth", "Hat", "Shoes", "Adorn"];
// Tab -> ItemType bitmask: 武器 11, 衣服 7, 帽子 8, 鞋子 9, 饰品 10.
let TAB_MASK: array<int> = [2048, 128, 256, 512, 1024];
// Tab -> the equipment slot it fills (饰品 fills whichever is free).
let TAB_SLOT: array<int> = [5, 1, 0, 2, 3];

// Six equipment slots, in `RoleState::equipment` order:
// 0 帽 · 1 衣 · 2 鞋 · 3 饰品一 · 4 饰品二 · 5 武器.
let SLOT_COUNT: int = 6;
// The five horizontal rows (Equip_Ctrl, 148x32 rects at (426, 2+20k)); the
// weapon uses the tall Weapon_Ctrl at (368,4,400,112) instead.
let ROW_X: float = 426.0;
let ROW_Y0: float = 2.0;
let ROW_STEP: float = 20.0;
let ROW_W: float = 148.0;
let ROW_H: float = 32.0;
let WEAPON_X: float = 368.0; let WEAPON_Y: float = 4.0;
let WEAPON_W: float = 32.0;  let WEAPON_H: float = 108.0;
// Slot icons, pressed against the left end of each row.
let ICON_NAME: array<string> = ["HatIcon", "ClothIcon", "ShoesIcon", "AdornIcon", "AdornIcon"];
let ICON_X: array<float> = [438.0, 438.0, 438.0, 438.0, 438.0];
let ICON_Y: array<float> = [8.0, 29.0, 50.0, 69.0, 91.0];
let WEAPON_ICON_X: float = 336.0; let WEAPON_ICON_Y: float = 40.0;

// List: same rects as the 道具 page, but the columns are 198 / 60.
let ROWS: int = 12;
let GRID_X: float = 269.0;
let GRID_Y0: float = 203.0;
let LIST_ROW_H: float = 23.0;
let COL_NAME_W: float = 198.0;
let LIST_TEXT_DY: float = 3.5;
let HEAD_TXT_X: float = 269.0; let HEAD_TXT_Y: float = 177.0;

let SB_TRACK_X: float = 529.0; let SB_TRACK_Y: float = 202.0;
let SB_UP_X: float = 536.0;    let SB_UP_Y: float = 216.0;
let SB_DOWN_X: float = 536.0;  let SB_DOWN_Y: float = 448.0;
let SB_ARROW_W: float = 22.0;  let SB_ARROW_H: float = 27.0;
let SB_THUMB_X: float = 534.0;
let SB_THUMB_TOP: float = 246.0;
let SB_THUMB_BOTTOM: float = 444.0;
let SB_THUMB_H: float = 28.0;

let DESC_X: float = 22.0; let DESC_Y: float = 372.0;
let DESC_WRAP: float = 196.0;

let SORT_Y: float = 492.0;
let SORT_W: float = 94.0; let SORT_H: float = 20.0;
let SORT_X: array<float> = [271.0, 373.0, 475.0];
let SORT_BASE: array<string> = ["Use", "Price", "Func"];

let INK_R: float = 0.05; let INK_G: float = 0.12; let INK_B: float = 0.0;

pub let CLOSE: int = -1;
pub let TO_STATE: int = -2;
pub let TO_SYSTEM: int = -3;
pub let TO_PROP: int = -4;
pub let TO_MAGIC: int = -5;
pub let TO_SWORD: int = -6;

// Packed state: member * 100000 + tab * 10000 + scroll * 100 + selection,
// where `member` indexes the party (not the actor id).
pub fn pack(member: int, tab: int, scroll: int, sel: int) -> int {
    return member * 100000 + tab * 10000 + scroll * 100 + sel;
}
pub fn member_of(state: int) -> int { return state / 100000; }
pub fn tab_of(state: int) -> int { return (state - member_of(state) * 100000) / 10000; }
pub fn scroll_of(state: int) -> int {
    return (state - member_of(state) * 100000 - tab_of(state) * 10000) / 100;
}
pub fn sel_of(state: int) -> int {
    return state - member_of(state) * 100000 - tab_of(state) * 10000 - scroll_of(state) * 100;
}

pub fn paint_equip_menu(
    ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
    mx: float, my: float, down: bool, click: bool, state: int,
) -> int {
    let lw = ui.display_size_x() as float;
    let lh = ui.display_size_y() as float;
    if lw <= 0.0 || lh <= 0.0 { return state; }

    let viewport = gui.Rect(0.0, 0.0, lw, lh);
    let native = gui.Size(chrome.REF_W, chrome.REF_H);
    let canvas = viewport.fit(native);
    let s = viewport.fit_scale(native);
    let cw = canvas.w;
    let ch = canvas.h;
    let ox = canvas.x;
    let oy = canvas.y;

    ui.fill_rect(0.0, 0.0, lw, lh, 0.0, 0.0, 0.0, 0.8);

    let party = pal3.party_size();
    let mut member = member_of(state);
    if member < 0 || member >= party { member = 0; }
    let mut actor = pal3.party_actor_id(member);
    if actor < 0 { actor = 0; }
    let mut tab = tab_of(state);
    if tab < 0 || tab > 4 { tab = 0; }
    let mut scroll = scroll_of(state);
    let mut sel = sel_of(state);

    // ---- Panels ----------------------------------------------------------
    chrome.sprite(ui, atlas, SPR_INFO, ox + INFO_X * s, oy + INFO_Y * s, s);
    chrome.sprite(ui, atlas, SPR_WORD, ox + WORD_X * s, oy + WORD_Y * s, s);
    chrome.sprite(ui, atlas, SPR_LISTFRAME, ox + LF_X * s, oy + LF_Y * s, s);
    chrome.paint_frame(ui, atlas, pal3, SPR_FRAME, ox, oy, s);

    // ---- Top strip -------------------------------------------------------
    // Each piece abuts the previous one at its native width.
    let mut top_x = TOP_X;
    for i in Range(0, 5) {
        let osp = atlas.sprite(TOP_PIECES[i]);
        if osp != null {
            let sp = osp!;
            chrome.sprite(ui, atlas, TOP_PIECES[i], ox + top_x * s, oy + TOP_Y * s, s);
            top_x = top_x + (sp.width() as float);
        }
    }

    // The party column down the right edge doubles as the character
    // selector — clicking a plate switches whose equipment is shown.
    let picked = chrome.paint_head_plates(ui, atlas, pal3, ox, oy, s, mx, my, click, true);
    if picked >= 0 && picked != member {
        member = picked;
        actor = pal3.party_actor_id(member);
        if actor < 0 { actor = 0; }
        scroll = 0;
        sel = 0;
    }

    // ---- The six equipment slots ----------------------------------------
    chrome.sprite(ui, atlas, SPR_WEAPON_CTRL + slot_variant(tab, 5) + ".tga",
        ox + WEAPON_X * s, oy + WEAPON_Y * s, s);
    chrome.sprite(ui, atlas, "ui/GameMainUI/Equip/WeaponIcon.tga",
        ox + WEAPON_ICON_X * s, oy + WEAPON_ICON_Y * s, s);

    for k in Range(0, 5) {
        let ry = ROW_Y0 + (k as float) * ROW_STEP;
        chrome.sprite(ui, atlas, SPR_EQUIP_CTRL + slot_variant(tab, k) + ".tga",
            ox + ROW_X * s, oy + ry * s, s);
        chrome.sprite(ui, atlas, "ui/GameMainUI/Equip/" + ICON_NAME[k] + ".tga",
            ox + ICON_X[k] * s, oy + ICON_Y[k] * s, s);

        // A worn piece shows its stat line, not its name — that is what
        // the original puts on these rows.
        let worn = pal3.equipped_item(actor, k);
        if worn >= 0 {
            pal3.draw_item_stat_line(ui, worn,
                ox + (ROW_X + chrome.TXT_MARGIN + 24.0) * s,
                oy + (ry + chrome.TXT_MARGIN) * s,
                chrome.TXT * s, INK_R, INK_G, INK_B, 1.0);
        }

        // Right-clicking a row takes the piece off. [Our binding: the
        // original routes this through the confirmation dialog.]
        let hover = mx >= ox + ROW_X * s && mx <= ox + (ROW_X + ROW_W) * s
            && my >= oy + ry * s && my <= oy + (ry + ROW_H) * s;
        if hover && click && ui.mouse_down(1) { let _ = pal3.unequip_slot(actor, k); }
    }
    let worn_weapon = pal3.equipped_item(actor, 5);

    // ---- Category tabs ---------------------------------------------------
    let mut new_tab = tab;
    for i in Range(0, 5) {
        let tx0 = ox + TAB_X[i] * s;
        let ty0 = oy + TAB_Y0 * s;
        let hover = mx >= tx0 && mx <= tx0 + TAB_W * s
            && my >= ty0 && my <= ty0 + TAB_H * s;
        let mut variant = "0";
        if i == tab { variant = "1"; }
        else { if hover { variant = "2"; } }
        chrome.sprite(ui, atlas, SPR_TAB + TAB_BASE[i] + variant + ".tga", tx0, ty0, s);
        if hover && click { new_tab = i; }
    }
    if new_tab != tab {
        tab = new_tab;
        scroll = 0;
        sel = 0;
    }

    // ---- List ------------------------------------------------------------
    let mask = TAB_MASK[tab];
    let count = pal3.inventory_size(mask);

    let mut max_scroll = count - ROWS;
    if max_scroll < 0 { max_scroll = 0; }
    if scroll > max_scroll { scroll = max_scroll; }
    if scroll < 0 { scroll = 0; }
    if sel >= count { sel = count - 1; }
    if sel < 0 { sel = 0; }

    let wheel = ui.mouse_wheel();
    if wheel > 0.0 { if scroll > 0 { scroll = scroll - 1; } }
    if wheel < 0.0 { if scroll < max_scroll { scroll = scroll + 1; } }

    let grid_x0 = ox + GRID_X * s;
    for k in Range(0, ROWS) {
        let ry0 = oy + (GRID_Y0 + (k as float) * LIST_ROW_H) * s;
        chrome.sprite(ui, atlas, SPR_GRID, grid_x0, ry0, s);

        let index = scroll + k;
        if index < count {
            let item_id = pal3.inventory_item_id(mask, index);
            if item_id >= 0 {
                let hover = mx >= grid_x0 && mx <= grid_x0 + 258.0 * s
                    && my >= ry0 && my <= ry0 + LIST_ROW_H * s;
                if index == sel {
                    chrome.sprite(ui, atlas, SPR_SELECTED, grid_x0, ry0, s);
                }
                if hover && click {
                    if index == sel {
                        // A second click on the highlighted row wears it.
                        let _ = pal3.equip_item(actor, item_id);
                    } else {
                        sel = index;
                    }
                }

                pal3.draw_item_name(ui, item_id,
                    grid_x0 + chrome.TXT_MARGIN * s,
                    ry0 + LIST_TEXT_DY * s,
                    chrome.TXT * s, INK_R, INK_G, INK_B, 1.0);
                chrome.widget_text(ui, grid_x0 + COL_NAME_W * s, ry0,
                    LIST_TEXT_DY - chrome.TXT_MARGIN, s, INK_R, INK_G, INK_B,
                    chrome.int_str(pal3.item_count(item_id)));
            }
        }
    }

    // 表头: 21 spaces between the two labels on this page (23 on 道具).
    chrome.widget_text(ui, ox + HEAD_TXT_X * s, oy + HEAD_TXT_Y * s, 0.0, s,
        INK_R, INK_G, INK_B, "名称                     数量");

    // ---- Scrollbar -------------------------------------------------------
    chrome.sprite(ui, atlas, SPR_SCROLL + "3.tga", ox + SB_TRACK_X * s, oy + SB_TRACK_Y * s, s);

    let up_x = ox + SB_UP_X * s;
    let up_y = oy + SB_UP_Y * s;
    let on_up = mx >= up_x && mx <= up_x + SB_ARROW_W * s && my >= up_y && my <= up_y + SB_ARROW_H * s;
    chrome.sprite(ui, atlas, SPR_SCROLL + arrow_variant(on_up, down, 4) + ".tga", up_x, up_y, s);
    if on_up && click { if scroll > 0 { scroll = scroll - 1; } }

    let dn_x = ox + SB_DOWN_X * s;
    let dn_y = oy + SB_DOWN_Y * s;
    let on_dn = mx >= dn_x && mx <= dn_x + SB_ARROW_W * s && my >= dn_y && my <= dn_y + SB_ARROW_H * s;
    chrome.sprite(ui, atlas, SPR_SCROLL + arrow_variant(on_dn, down, 7) + ".tga", dn_x, dn_y, s);
    if on_dn && click { if scroll < max_scroll { scroll = scroll + 1; } }

    let mut frac = 0.0;
    if max_scroll > 0 { frac = (scroll as float) / (max_scroll as float); }
    let thumb_y = SB_THUMB_TOP + frac * (SB_THUMB_BOTTOM - SB_THUMB_TOP - SB_THUMB_H);
    chrome.sprite(ui, atlas, SPR_SCROLL + "0.tga", ox + SB_THUMB_X * s, oy + thumb_y * s, s);

    // ---- Description of the highlighted piece ----------------------------
    if count > 0 {
        let item_id = pal3.inventory_item_id(mask, sel);
        if item_id >= 0 {
            pal3.draw_item_description(ui, item_id,
                ox + (DESC_X + chrome.TXT_MARGIN) * s,
                oy + (DESC_Y + chrome.TXT_MARGIN) * s,
                chrome.TXT * s, DESC_WRAP * s, INK_R, INK_G, INK_B, 1.0);
        }
    } else {
        // Nothing to fit — describe what is already worn in this slot.
        let worn = pal3.equipped_item(actor, TAB_SLOT[tab]);
        if worn >= 0 {
            pal3.draw_item_description(ui, worn,
                ox + (DESC_X + chrome.TXT_MARGIN) * s,
                oy + (DESC_Y + chrome.TXT_MARGIN) * s,
                chrome.TXT * s, DESC_WRAP * s, INK_R, INK_G, INK_B, 1.0);
        }
    }

    // ---- Sort buttons (drawn, inert) ------------------------------------
    for i in Range(0, 3) {
        let sx0 = ox + SORT_X[i] * s;
        let sy0 = oy + SORT_Y * s;
        let hover = mx >= sx0 && mx <= sx0 + SORT_W * s && my >= sy0 && my <= sy0 + SORT_H * s;
        let variant = if hover { "2" } else { "0" };
        chrome.sprite(ui, atlas, SPR_SORT + SORT_BASE[i] + variant + ".tga", sx0, sy0, s);
    }

    // ---- Bottom action toolbar -------------------------------------------
    let hit = chrome.paint_toolbar(ui, atlas, ox, oy, cw, ch, s, mx, my, down, click,
        chrome.PAGE_EQUIP);
    if hit == chrome.TOOLBAR_EXIT { return CLOSE; }
    if hit == chrome.PAGE_STATE { return TO_STATE; }
    if hit == chrome.PAGE_PROP { return TO_PROP; }
    if hit == chrome.PAGE_MAGIC { return TO_MAGIC; }
    if hit == chrome.PAGE_SWORD { return TO_SWORD; }
    if hit == chrome.PAGE_SYSTEM { return TO_SYSTEM; }

    return pack(member, tab, scroll, sel);
}

// The slot the open tab targets is drawn selected (`<base>2`), the rest
// normal — the original does the same through `FUN_00445e50`.
fn slot_variant(tab: int, slot: int) -> string {
    if TAB_SLOT[tab] == slot { return "2"; }
    return "0";
}

fn arrow_variant(hover: bool, down: bool, base: int) -> string {
    if hover {
        if down { return chrome.int_str(base + 2); }
        return chrome.int_str(base + 1);
    }
    return chrome.int_str(base);
}
