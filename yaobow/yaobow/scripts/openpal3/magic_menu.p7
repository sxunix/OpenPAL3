// PAL3 in-game 仙术 (magic) page — standalone overlay, reached from any
// of the other full-screen pages' toolbars.
//
// Geometry from the original PAL3.exe (v1.4): page init `FUN_0048d5d0`,
// grids + headers `FUN_0048a390`, list refill `FUN_0048b8f0`, the cast
// action `FUN_0048c610`, arrange `FUN_0048a010`. Write-up in
// switch/re/notes/magic_page_layout.md.
//
// This page is laid out differently from 道具 / 装备: a wider list frame,
// nine rows of 29 px instead of twelve of 23, NO scrollbar, eight tabs,
// and a column set that changes per tab.
//
// How the tabs filter: the original pre-sorts each character's skills into
// eight buckets (`GetRoleSkill` in magicui.cpp; `IPal3Service::skill_tab`):
// 特技 (type 0) -> 技; a 仙术 with exactly one of 风雷水火土 -> that tab;
// anything else -> 双; only skills whose `user[]` has the character.
//
// The last tab, 合, is not combo skills but 合成术 (item recipes —
// `magicui.cpp`'s `IDL_MAGIC_COMLIST`): the character's learnt recipes with
// their three materials and success rate. Selecting one shows the product's
// name, description and its spinning 3D model in the Info panel (the only
// tab with a 3D preview); a second click on it (the original's double-click)
// composes — the dialogs and the rules live in Rust (compose_dialog.rs,
// states/compose.rs).
//
// Casting outside combat (`magicui.cpp`, rules in states/magic_use.rs): a
// second click on the selected row (the original's double-click) checks the
// skill and, if it can go, enters the pick-a-person state — the list stops
// taking clicks, NeedArrows light up, hovering or clicking a plate moves the
// arrow (wa001), a second click on the same plate casts. Right click or a
// tab change backs out. Refusals and the level-up notice come up in the
// page's message box.

import radiance;
import shared.openpal3;
import radiance_scripting.ui as gui;
import yaobow.openpal3.menu_chrome as chrome;

// --- Sprites -------------------------------------------------------------
let SPR_FRAME: string     = "ui/GameMainUI/Magic/Frame.tga";
let SPR_INFO: string      = "ui/GameMainUI/Magic/Info.tga";
let SPR_XS: string        = "ui/GameMainUI/Magic/xs.tga";
let SPR_LISTFRAME: string = "ui/GameMainUI/Magic/ListFrame.tga";
let SPR_SELECTED: string  = "ui/assistant/Communal/ListBoxSelPic.tga";
let SPR_TAB: string       = "ui/GameMainUI/Magic/";
// Grid art per tab: 技 uses Skill_Grid, the element/双 tabs Magic_Grid,
// 合 Com_Grid.
let SPR_GRID_SKILL: string = "ui/GameMainUI/Magic/Skill_Grid.tga";
let SPR_GRID_MAGIC: string = "ui/GameMainUI/Magic/Magic_Grid.tga";
let SPR_GRID_COMBO: string = "ui/GameMainUI/Magic/Com_Grid.tga";

// --- Layout (native 800x600) ---------------------------------------------
let INFO_X: float = 10.0;  let INFO_Y: float = 125.0;
let XS_X: float = 18.0;    let XS_Y: float = 128.0;
let LF_X: float = 213.0;   let LF_Y: float = 125.0;

// Eight tabs, 42x50, y 124..174 — one pixel lower than the other pages.
let TAB_Y0: float = 124.0;
let TAB_W: float = 42.0;   let TAB_H: float = 50.0;
let TAB_X: array<float> = [229.0, 272.0, 315.0, 358.0, 401.0, 444.0, 487.0, 529.0];
let TAB_BASE: array<string> = ["Skill", "Shui", "Huo", "Lei", "Feng", "Tu", "Suang", "Combo"];
let TAB_SKILL: int = 0;
// Each tab's title header (AssisLang): 技 391, 水 392, 火 393, 雷 394,
// 风 395, 土 396, 双 397.
let TAB_TITLE: array<int> = [391, 392, 393, 394, 395, 396, 397, 127];
let TAB_COMBO: int = 7;

// 合 tab: list columns are three 98s and a 36 (`Com1..3`, `Percent`); the
// header labels (AssisLang 127..130) sit at +0, +94, +192, +290.
let COM_COL: array<float> = [0.0, 98.0, 196.0, 294.0];
let COM_HEAD_X: array<float> = [0.0, 94.0, 192.0, 290.0];
let LANG_COM_HEAD: int = 127;
// 3D preview: `SetOrthosize(160)`, `SetOriginPt(110, 268, 600)`,
// `SetRotateMode(1, 0)` — the product of the selected recipe.
let VIEW_MAGIC: int = 5;
let VIEW_SPIN: float = 98.0;

// Nine rows at (232, 207+29k, 565, 236+29k); the list rect is
// (232,207,566,485) and the row height the widget reports is 30.
let ROWS: int = 9;
let GRID_X: float = 232.0;
let GRID_Y0: float = 207.0;
let ROW_PITCH: float = 29.0;
let ROW_H: float = 30.0;
let GRID_W: float = 333.0;
// A row is 30 px tall against a 16 px cell, so centre the text. [推断]
let ROW_TEXT_DY: float = 7.0;

// Column widths per tab: 技 = Name 276 + Att 92; element/双 = Name 150 +
// Att 72 + Lv 38 + UseTimes 72; 合 = three 98s + 36.
let COL_SKILL_NAME: float = 276.0;
let COL_MAGIC_NAME: float = 150.0;
let COL_MAGIC_ATT: float = 72.0;
let COL_MAGIC_LV: float = 38.0;

// Header row (231,177,607,209) — 32 tall, one line.
let HEAD_X: float = 231.0; let HEAD_Y: float = 177.0;

// Info panel text.
let NAME_X: float = 56.0;  let NAME_Y: float = 130.0;
let DESC_X: float = 22.0;  let DESC_Y: float = 386.0;
let DESC_WRAP: float = 156.0;

let INK_R: float = 0.05; let INK_G: float = 0.12; let INK_B: float = 0.0;
// The selected skill's name is drawn in the original's light yellow.
let NAME_R: float = 1.0; let NAME_G: float = 0.96; let NAME_B: float = 0.56;

// `IPal3Service::skill_info` selectors.
let SK_SP: int = 2;
let SK_MP: int = 3;

pub let CLOSE: int = -1;
pub let TO_STATE: int = -2;
pub let TO_SYSTEM: int = -3;
pub let TO_PROP: int = -4;
pub let TO_EQUIP: int = -5;
pub let TO_SWORD: int = -6;
pub let TO_ARRAY: int = -7;
pub let TO_BOOK: int = -8;

// Packed state: member * 10000 + tab * 100 + selection. There is no
// scrollbar on this page, so there is no scroll offset to carry.
pub fn pack(member: int, tab: int, sel: int) -> int {
    return member * 10000 + tab * 100 + sel;
}
pub fn member_of(state: int) -> int { return state / 10000; }
pub fn tab_of(state: int) -> int { return (state - member_of(state) * 10000) / 100; }
pub fn sel_of(state: int) -> int {
    return state - member_of(state) * 10000 - tab_of(state) * 100;
}

pub fn paint_magic_menu(
    ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
    mx: float, my: float, down: bool, click: bool, state: int,
) -> int {
    let lw = ui.display_size_x() as float;
    let lh = ui.display_size_y() as float;
    if lw <= 0.0 || lh <= 0.0 { return state; }

    let viewport = gui.Rect(0.0, 0.0, lw, lh);
    let native = gui.Size(chrome.REF_W, chrome.REF_H);
    let canvas = viewport.fit(native);
    let s = viewport.fit_scale(native);
    let cw = canvas.w;
    let ch = canvas.h;
    let ox = canvas.x;
    let oy = canvas.y;

    ui.fill_rect(0.0, 0.0, lw, lh, 0.0, 0.0, 0.0, 0.8);

    // A compose dialog (or the 5 s wait for its result) takes every click
    // (`CtlList(false)` and the modal `MUIDialog`); so does the page's
    // message box.
    let busy = pal3.compose_busy() || pal3.menu_message_open();
    let page_click = click && !busy;
    // Picking a person for a skill: the list is disabled (`CtlList(false)`).
    let using = pal3.magic_user() >= 0;
    let list_click = page_click && !using;
    // 右键退出选人（`UIWM_RCLICK`）。
    if using && ui.mouse_down(1) { pal3.magic_cancel(); }

    let party = pal3.party_size();
    let mut member = member_of(state);
    if member < 0 || member >= party { member = 0; }
    let mut actor = pal3.party_actor_id(member);
    if actor < 0 { actor = 0; }
    let mut tab = tab_of(state);
    if tab < 0 || tab > 7 { tab = 0; }
    let mut sel = sel_of(state);

    // ---- Panels ----------------------------------------------------------
    chrome.sprite(ui, atlas, SPR_INFO, ox + INFO_X * s, oy + INFO_Y * s, s);
    chrome.sprite(ui, atlas, SPR_XS, ox + XS_X * s, oy + XS_Y * s, s);
    chrome.sprite(ui, atlas, SPR_LISTFRAME, ox + LF_X * s, oy + LF_Y * s, s);
    chrome.paint_frame(ui, atlas, pal3, SPR_FRAME, ox, oy, s);

    // The party column doubles as the character selector, same as 装备.
    let picked = chrome.paint_head_plates(ui, atlas, pal3, ox, oy, s, mx, my, page_click, true);
    if using {
        // Picking a person: plates move the arrow / cast instead of
        // switching character (the service plays the sounds).
        let over = chrome.head_at(pal3, ox, oy, s, mx, my);
        if over >= 0 { pal3.magic_hover(chrome.role_at(pal3, over)); }
        if picked >= 0 { pal3.magic_head_click(chrome.role_at(pal3, picked)); }
        chrome.paint_magic_arrows(ui, atlas, pal3, ox, oy, s);
    } else if picked >= 0 {
        // Any plate click plays wa001 (`IDB_ROLEHEAD_MAGIC`).
        pal3.ui_sound(chrome.SND_CLICK);
    }
    // (Judged on the state before this click: the click that casts can end
    // the picking, and must not then also switch character.)
    if picked >= 0 && picked != member && !using {
        member = picked;
        actor = pal3.party_actor_id(member);
        if actor < 0 { actor = 0; }
        sel = 0;
    }

    // ---- Tabs ------------------------------------------------------------
    let mut new_tab = tab;
    for i in Range(0, 8) {
        let tx0 = ox + TAB_X[i] * s;
        let ty0 = oy + TAB_Y0 * s;
        let hover = mx >= tx0 && mx <= tx0 + TAB_W * s
            && my >= ty0 && my <= ty0 + TAB_H * s;
        let mut variant = "0";
        if i == tab { variant = "1"; }
        else { if hover { variant = "2"; } }
        chrome.sprite(ui, atlas, SPR_TAB + TAB_BASE[i] + variant + ".tga", tx0, ty0, s);
        // Any tab click plays wa001 (`IDB_LIST_CTRL`).
        if hover && page_click {
            new_tab = i;
            pal3.ui_sound(chrome.SND_CLICK);
            // 换页签取消施法（`ControlPage`）。
            pal3.magic_cancel();
        }
    }
    if new_tab != tab {
        tab = new_tab;
        sel = 0;
    }

    // ---- The tab's skills ------------------------------------------------
    // The character's learned skills, narrowed to this tab's bucket. The
    // list is short (a character never learns more than a few dozen), so
    // it is rescanned per row rather than materialised.
    let mut count = count_in_tab(pal3, actor, tab);
    if tab == TAB_COMBO { count = pal3.compose_count(actor); }
    if sel >= count { sel = count - 1; }
    if sel < 0 { sel = 0; }

    // ---- Rows ------------------------------------------------------------
    let grid_x0 = ox + GRID_X * s;
    for k in Range(0, ROWS) {
        let ry0 = oy + (GRID_Y0 + (k as float) * ROW_PITCH) * s;
        chrome.sprite(ui, atlas, grid_sprite(tab), grid_x0, ry0, s);

        if k < count && tab == TAB_COMBO {
            let recipe = pal3.compose_recipe(actor, k);
            let hover = mx >= grid_x0 && mx <= grid_x0 + GRID_W * s
                && my >= ry0 && my <= ry0 + ROW_H * s;
            if k == sel {
                chrome.sprite_additive(ui, atlas, SPR_SELECTED, grid_x0, ry0, s);
            }
            if hover && page_click {
                // A second click on the highlighted row is the original's
                // double-click: check the materials, then ask.
                if k == sel { pal3.compose_start(actor, recipe); }
                sel = k;
            }
            let ty = ry0 + ROW_TEXT_DY * s;
            for m in Range(0, 3) {
                let mat = pal3.compose_info(recipe, m + 1);
                if mat > 0 {
                    pal3.draw_item_name(ui, mat, grid_x0 + (COM_COL[m] + chrome.TXT_MARGIN) * s, ty,
                        chrome.TXT * s, INK_R, INK_G, INK_B, 1.0);
                }
            }
            chrome.widget_text(ui, grid_x0 + COM_COL[3] * s, ry0,
                ROW_TEXT_DY - chrome.TXT_MARGIN, s, INK_R, INK_G, INK_B,
                chrome.int_str(pal3.compose_rate(actor, recipe)) + "%");
        } else if k < count {
            let id = nth_in_tab(pal3, actor, tab, k);
            let hover = mx >= grid_x0 && mx <= grid_x0 + GRID_W * s
                && my >= ry0 && my <= ry0 + ROW_H * s;
            if k == sel {
                chrome.sprite_additive(ui, atlas, SPR_SELECTED, grid_x0, ry0, s);
            }
            if hover && list_click {
                // A second click on the selected row is the double-click:
                // try to cast (`UIWM_LB_DBCLICK`).
                if k == sel { pal3.magic_begin(actor, id); }
                sel = k;
            }

            // Rows the character cannot cast right now are grey
            // (`CheckUsable(…, false)` → RGB 127,127,127).
            let mut ir = INK_R; let mut ig = INK_G; let mut ib = INK_B;
            if !pal3.magic_usable(actor, id) { ir = 0.5; ig = 0.5; ib = 0.5; }
            let ty = ry0 + ROW_TEXT_DY * s;
            pal3.draw_skill_name(ui, id, grid_x0 + chrome.TXT_MARGIN * s, ty,
                chrome.TXT * s, ir, ig, ib, 1.0);

            // `GetListVal`: the cost column is 气 if any, else 神 (技: if
            // not negative); the element tabs add the learnt level + 1 and
            // how many times this character has cast it.
            let sp = pal3.skill_info(id, SK_SP);
            let mp = pal3.skill_info(id, SK_MP);
            if tab == TAB_SKILL {
                let mut cost = "";
                if sp >= 0 { cost = chrome.int_str(sp); }
                else { if mp >= 0 { cost = chrome.int_str(mp); } }
                chrome.widget_text(ui, grid_x0 + COL_SKILL_NAME * s, ry0,
                    ROW_TEXT_DY - chrome.TXT_MARGIN, s, ir, ig, ib, cost);
            } else {
                let mut cost = 0;
                if sp > 0 { cost = sp; }
                else { if mp > 0 { cost = mp; } }
                chrome.widget_text(ui, grid_x0 + COL_MAGIC_NAME * s, ry0,
                    ROW_TEXT_DY - chrome.TXT_MARGIN, s, ir, ig, ib, chrome.int_str(cost));
                chrome.widget_text(ui, grid_x0 + (COL_MAGIC_NAME + COL_MAGIC_ATT) * s, ry0,
                    ROW_TEXT_DY - chrome.TXT_MARGIN, s, ir, ig, ib,
                    chrome.int_str(pal3.learned_skill(actor, id, 0) + 1));
                chrome.widget_text(ui,
                    grid_x0 + (COL_MAGIC_NAME + COL_MAGIC_ATT + COL_MAGIC_LV) * s, ry0,
                    ROW_TEXT_DY - chrome.TXT_MARGIN, s, ir, ig, ib,
                    chrome.int_str(pal3.learned_skill(actor, id, 1)));
            }
        }
    }

    // ---- Header ----------------------------------------------------------
    if tab == TAB_COMBO {
        for i in Range(0, 4) {
            pal3.draw_lang_text(ui, LANG_COM_HEAD + i,
                ox + (HEAD_X + COM_HEAD_X[i] + chrome.TXT_MARGIN) * s,
                oy + (HEAD_Y + chrome.TXT_MARGIN) * s,
                chrome.TXT * s, INK_R, INK_G, INK_B, 1.0);
        }
    } else {
        // Four header widgets (`m_title`, `ControlPage`): the tab's own
        // title, then 消耗气 / 消耗神, 等级, 使用次数.
        let hx = ox + (HEAD_X + chrome.TXT_MARGIN) * s;
        let hy = oy + (HEAD_Y + chrome.TXT_MARGIN) * s;
        pal3.draw_lang_text(ui, TAB_TITLE[tab], hx, hy, chrome.TXT * s, INK_R, INK_G, INK_B, 1.0);
        if tab == TAB_SKILL {
            pal3.draw_lang_pair(ui, 124, 15, hx + 274.0 * s, hy, chrome.TXT * s,
                INK_R, INK_G, INK_B, 1.0);
        } else {
            pal3.draw_lang_pair(ui, 124, 16, hx + 146.0 * s, hy, chrome.TXT * s,
                INK_R, INK_G, INK_B, 1.0);
            pal3.draw_lang_text(ui, 125, hx + 218.0 * s, hy, chrome.TXT * s,
                INK_R, INK_G, INK_B, 1.0);
            pal3.draw_lang_pair(ui, 126, 56, hx + 256.0 * s, hy, chrome.TXT * s,
                INK_R, INK_G, INK_B, 1.0);
        }
    }

    // ---- The selected skill ----------------------------------------------
    if count > 0 && tab == TAB_COMBO {
        let product = pal3.compose_info(pal3.compose_recipe(actor, sel), 0);
        let _v = pal3.draw_model_view(ui, VIEW_MAGIC, "item:" + chrome.int_str(product),
            160.0, 110.0, 268.0, 0.0, false, 0, 1.0, 0, ox, oy, s);
        pal3.spin_model_view(VIEW_MAGIC, VIEW_SPIN);
        pal3.draw_item_name(ui, product,
            ox + (NAME_X + chrome.TXT_MARGIN) * s,
            oy + (NAME_Y + chrome.TXT_MARGIN) * s,
            chrome.TXT * s, NAME_R, NAME_G, NAME_B, 1.0);
        pal3.draw_item_description(ui, product,
            ox + (DESC_X + chrome.TXT_MARGIN) * s,
            oy + (DESC_Y + chrome.TXT_MARGIN) * s,
            chrome.TXT * s, DESC_WRAP * s, INK_R, INK_G, INK_B, 1.0);
    } else if count > 0 {
        let id = nth_in_tab(pal3, actor, tab, sel);
        pal3.draw_skill_name(ui,
            id,
            ox + (NAME_X + chrome.TXT_MARGIN) * s,
            oy + (NAME_Y + chrome.TXT_MARGIN) * s,
            chrome.TXT * s, NAME_R, NAME_G, NAME_B, 1.0);
        pal3.draw_skill_description(ui,
            id,
            ox + (DESC_X + chrome.TXT_MARGIN) * s,
            oy + (DESC_Y + chrome.TXT_MARGIN) * s,
            chrome.TXT * s, DESC_WRAP * s, INK_R, INK_G, INK_B, 1.0);
    }

    // ---- Bottom action toolbar -------------------------------------------
    let hit = chrome.paint_toolbar(ui, atlas, pal3, ox, oy, cw, ch, s, mx, my, down, page_click,
        chrome.PAGE_MAGIC);

    // The compose dialogs go over everything, then the message box.
    let _busy = pal3.paint_compose_dialogs(ui, mx, my, down, click, ox, oy, s);
    let _msg = pal3.paint_menu_message(ui, click, ox, oy, s);
    if hit == chrome.TOOLBAR_EXIT { return CLOSE; }
    if hit == chrome.PAGE_STATE { return TO_STATE; }
    if hit == chrome.PAGE_PROP { return TO_PROP; }
    if hit == chrome.PAGE_EQUIP { return TO_EQUIP; }
    if hit == chrome.PAGE_SWORD { return TO_SWORD; }
    if hit == chrome.PAGE_ARRAY { return TO_ARRAY; }
    if hit == chrome.PAGE_BOOK { return TO_BOOK; }
    if hit == chrome.PAGE_SYSTEM { return TO_SYSTEM; }

    return pack(member, tab, sel);
}

// How many of this character's skills fall under `tab`.
fn count_in_tab(pal3: box<openpal3.IPal3Service>, actor: int, tab: int) -> int {
    let learned = pal3.skill_count(actor);
    let mut n = 0;
    let mut i = 0;
    while i < learned {
        let id = pal3.skill_id(actor, i);
        if id >= 0 && belongs_to_tab(pal3, actor, id, tab) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// The `index`-th of them, or -1.
fn nth_in_tab(pal3: box<openpal3.IPal3Service>, actor: int, tab: int, index: int) -> int {
    let learned = pal3.skill_count(actor);
    let mut n = 0;
    let mut i = 0;
    while i < learned {
        let id = pal3.skill_id(actor, i);
        if id >= 0 && belongs_to_tab(pal3, actor, id, tab) {
            if n == index { return id; }
            n = n + 1;
        }
        i = i + 1;
    }
    return -1;
}

// Which tab a learned skill shows up under (`GetRoleSkill`).
fn belongs_to_tab(pal3: box<openpal3.IPal3Service>, actor: int, skill_id: int, tab: int) -> bool {
    if tab == TAB_COMBO { return false; }
    return pal3.skill_tab(actor, skill_id) == tab;
}

fn grid_sprite(tab: int) -> string {
    if tab == TAB_SKILL { return SPR_GRID_SKILL; }
    if tab == TAB_COMBO { return SPR_GRID_COMBO; }
    return SPR_GRID_MAGIC;
}


