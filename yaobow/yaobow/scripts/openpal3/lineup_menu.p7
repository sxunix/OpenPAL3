// PAL3 in-game 阵法 (五灵阵法 / formation) page — standalone overlay,
// reached from any other full-screen page's toolbar.
//
// Geometry from the original PAL3.exe (v1.4): page init `FUN_00483650`,
// per-character panel `FUN_004841b0(角色, X, Y)`, arrange `FUN_00484660`,
// placement state `FUN_004844a0`. Write-up in
// switch/re/notes/lineup_page_layout.md.
//
// This page is laid out unlike any other:
//   * no party plate column — its `Frame.tga` is narrower (153 px at
//     x=631, against 195/197 at x=592 elsewhere) to make room,
//   * a `RoleFrame` strip across the top with five portrait slots,
//   * one settings plank per party member down the right side, each with
//     the six 托管 (auto-battle) switches in 2 columns x 3 rows.
//
// The 五灵 formation itself is 3D in the original (`wl.pol`, the party
// standing on it, `pointer.cvd` markers on the empty positions); the
// service renders it (`draw_lineup_disc`) and this page draws on top.
// Clicking the disc works as in the original (`0x485230`): click a
// character to select it (the disc spins it to the front), click another
// to swap, or an empty marker to move there — the service handles that
// from the same mouse state.
//
// The planks are not 阵位 buttons (an earlier reading had them so): in the
// original's source (`lineupui.cpp`) they are `IDB_LINEUP_STATE[角色][LT_*]`
// push buttons — 攻击 特技 全力/万全 down the left, 物品 仙术 AI down the
// right — writing the character's 托管 flags (`bAutoCtrl`, `bAIAttack`, …).
// The rules (AI unlocks the rest, releasing 攻击 drops everything) are in
// states/lineup_plank.rs; the service keeps the planks.
//
// The portrait strip: the leader in slot 0 (its `_lead` art, the head
// button while hovered), the others after it. Clicking a portrait outside a
// maze says 「非迷宫，不可更换队列」; in a maze it makes that character
// the leader (`SelRoleHead`).
//
// A character's position is stored as the button's index 0..5. On the
// way back to the role record the original writes index + 1
// (`FUN_004845f0`): 1..5 水火风雷土, 6 the middle of the disc; 合击技
// check those values (`combat/combo.rs`). Reading them back when the page
// opens (`FUN_00485980`) crosses 3 and 4, so every visit swaps whoever
// stands on buttons 2 and 3 — reproduced via `pal3.lineup_page_opened()`.

import radiance;
import shared.openpal3;
import radiance_scripting.ui as gui;
import yaobow.openpal3.menu_chrome as chrome;

// --- Sprites -------------------------------------------------------------
let SPR_FRAME: string    = "ui/GameMainUI/Lineup/Frame.tga";
let SPR_ROLEFRAME: string = "ui/GameMainUI/Lineup/RoleFrame.tga";
let SPR_ZHENLIE: string  = "ui/GameMainUI/Lineup/zhenlie.tga";
let SPR_NOBODY: string   = "ui/GameMainUI/Lineup/NoBody.tga";
let SPR_HEAD: string     = "ui/GameMainUI/Lineup/Head";
let SPR_PLANK_UP: string = "ui/GameMainUI/Lineup/PlankUP.tga";
let SPR_PLANK_DW: string = "ui/GameMainUI/Lineup/PlankDW.tga";
let SPR_SLOT: string     = "ui/GameMainUI/Lineup/Lineup";

// --- Layout (native 800x600) ---------------------------------------------
// This page's frame is its own; the rest of the header is shared chrome.
let FR_X: float = 631.0; let FR_Y: float = 18.0;
let RF_X: float = 0.0;   let RF_Y: float = 0.0;
let ZL_X: float = 100.0; let ZL_Y: float = 95.0;

// Five portrait slots across the top strip, 55x57 at y 24..81. Slot 4's
// rect is identical to slot 3's in the original — recorded as-is rather
// than "corrected", since it is what the executable writes.
let TOP_SLOT_X: array<float> = [50.0, 136.0, 216.0, 296.0, 296.0];
let TOP_SLOT_Y: float = 24.0;
let TOP_SLOT_W: float = 55.0; let TOP_SLOT_H: float = 57.0;

// Per-character panel: base (638, 42), each further member 124 lower.
let PANEL_X: float = 638.0;
let PANEL_Y0: float = 42.0;
let PANEL_STEP: float = 124.0;
let PLANK_UP_DX: float = 40.0; let PLANK_UP_DY: float = 0.0;
let PLANK_DW_DX: float = 44.0; let PLANK_DW_DY: float = 118.0;
let NAME_DX: float = 50.0; let NAME_DY: float = 18.0;
// The six 托管 switches, 74x26 each, 2 columns x 3 rows (`AdjustPlank`):
// left column 0 攻击, 1 特技, 4 全力/万全; right column 3 物品, 2 仙术,
// 5 AI. Art `Lineup<n>0` released, `Lineup<n>1` pressed.
let BTN_W: float = 74.0; let BTN_H: float = 26.0;
let BTN_COL_DX: float = 73.0;
let BTN_DY0: float = 42.0;
let BTN_ROW_STEP: float = 26.0;
let BTN_INDEX: array<int> = [0, 3, 1, 2, 4, 5];

// The character names the original pulls from its string table.
let ROLE_NAME: array<string> = ["景天", "雪见", "龙葵", "紫萱", "长卿"];
// The leader's static art in slot 0 (`MU_LINEUP_ROLELEAD`).
let LEAD_ART: array<string> = ["jingtian", "xuejian", "longkui", "zixuan", "changqing"];
let SPR_LEAD_DIR: string = "ui/GameMainUI/Lineup/";

let INK_R: float = 0.05; let INK_G: float = 0.12; let INK_B: float = 0.0;
let NAME_R: float = 1.0; let NAME_G: float = 0.98; let NAME_B: float = 0.12;

pub let CLOSE: int = -1;
pub let TO_STATE: int = -2;
pub let TO_SYSTEM: int = -3;
pub let TO_PROP: int = -4;
pub let TO_EQUIP: int = -5;
pub let TO_MAGIC: int = -6;
pub let TO_SWORD: int = -7;
pub let TO_BOOK: int = -8;

pub fn paint_lineup_menu(
    ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
    mx: float, my: float, down: bool, click: bool, state: int,
) -> int {
    let lw = ui.display_size_x() as float;
    let lh = ui.display_size_y() as float;
    if lw <= 0.0 || lh <= 0.0 { return state; }

    // 刚打开这一页（从别处进来时 state 置 0）：原版 `FUN_00484660` 这时从角色记录重读站位，
    // 读法把值 3 / 4 交叉，见 `PersistentState::reread_lineup_for_page`。之后返回 1。
    if state == 0 { pal3.lineup_page_opened(); }

    let viewport = gui.Rect(0.0, 0.0, lw, lh);
    let native = gui.Size(chrome.REF_W, chrome.REF_H);
    let canvas = viewport.fit(native);
    let s = viewport.fit_scale(native);
    let cw = canvas.w;
    let ch = canvas.h;
    let ox = canvas.x;
    let oy = canvas.y;

    ui.fill_rect(0.0, 0.0, lw, lh, 0.0, 0.0, 0.0, 0.8);

    // ---- 3D: the 五灵 disc under everything else --------------------------
    // The original draws its 3D nodes (`0x4850e0`) before the 2D widgets.
    pal3.draw_lineup_disc(ui, mx, my, down, ox, oy, s);

    // ---- Frame and header ------------------------------------------------
    chrome.sprite(ui, atlas, SPR_FRAME, ox + FR_X * s, oy + FR_Y * s, s);
    chrome.sprite(ui, atlas, chrome.SPR_FRAME_LINE,
        ox + chrome.FRL_X * s, oy + chrome.FRL_Y * s, s);
    chrome.sprite(ui, atlas, chrome.SPR_TIMEMONEY, ox + chrome.TM_X * s, oy + chrome.TM_Y * s, s);
    chrome.widget_text(ui, ox + chrome.MONEY_X * s, oy + chrome.MONEY_Y * s, 0.0, s,
        1.0, 0.95, 0.5, chrome.int_str(pal3.money()));
    chrome.widget_text(ui, ox + chrome.TIME_X * s, oy + chrome.TIME_Y * s, 0.0, s,
        0.85, 1.0, 0.95, chrome.time_str(pal3.play_time()));

    chrome.sprite(ui, atlas, SPR_ROLEFRAME, ox + RF_X * s, oy + RF_Y * s, s);
    chrome.sprite(ui, atlas, SPR_ZHENLIE, ox + ZL_X * s, oy + ZL_Y * s, s);

    // A message box takes every click until it closes.
    let page_click = click && !pal3.menu_message_open();

    // ---- Top strip: the party's portraits ---------------------------------
    // Every slot gets `NoBody` first; the strip's heads go on top.
    for i in Range(0, 5) {
        chrome.sprite(ui, atlas, SPR_NOBODY, ox + TOP_SLOT_X[i] * s, oy + TOP_SLOT_Y * s, s);
    }
    for i in Range(0, 5) {
        let role = pal3.lineup_strip_role(i);
        if role >= 0 {
            let sx = ox + TOP_SLOT_X[i] * s;
            let sy = oy + TOP_SLOT_Y * s;
            let hover = mx >= sx && mx <= sx + TOP_SLOT_W * s && my >= sy && my <= sy + TOP_SLOT_H * s;
            let mut v = "0";
            if hover { v = if down { "2" } else { "1" }; }
            if i == 0 && !hover {
                chrome.sprite(ui, atlas, SPR_LEAD_DIR + LEAD_ART[role] + "_lead.tga", sx, sy, s);
            } else {
                chrome.sprite(ui, atlas, SPR_HEAD + chrome.int_str(role) + v + ".tga", sx, sy, s);
            }
            if hover && page_click { pal3.lineup_head_click(i); }
        }
    }

    // ---- One settings plank per party member ------------------------------
    let mut m = 0;
    while pal3.lineup_panel_role(m) >= 0 {
        let role = pal3.lineup_panel_role(m);
        let px = PANEL_X;
        let py = PANEL_Y0 + (m as float) * PANEL_STEP;

        chrome.sprite(ui, atlas, SPR_PLANK_UP,
            ox + (px + PLANK_UP_DX) * s, oy + (py + PLANK_UP_DY) * s, s);
        chrome.sprite(ui, atlas, SPR_PLANK_DW,
            ox + (px + PLANK_DW_DX) * s, oy + (py + PLANK_DW_DY) * s, s);
        chrome.widget_text(ui, ox + (px + NAME_DX) * s, oy + (py + NAME_DY) * s, 0.0, s,
            NAME_R, NAME_G, NAME_B, name_of(role));

        for b in Range(0, 6) {
            let col = b - (b / 2) * 2;
            let row = b / 2;
            let bx = ox + (px + (col as float) * BTN_COL_DX) * s;
            let by = oy + (py + BTN_DY0 + (row as float) * BTN_ROW_STEP) * s;
            let n = BTN_INDEX[b];

            // `Lineup<n>1.tga` pressed, `<n>0` released (`UIPushButton`).
            let st = pal3.lineup_button_state(role, n);
            let mut variant = "0";
            if st % 2 == 1 { variant = "1"; }
            chrome.sprite(ui, atlas, SPR_SLOT + chrome.int_str(n) + variant + ".tga", bx, by, s);

            if page_click
                && mx >= bx && mx <= bx + BTN_W * s
                && my >= by && my <= by + BTN_H * s {
                pal3.lineup_button_click(role, n);
            }
        }

        m = m + 1;
    }

    // ---- Bottom action toolbar -------------------------------------------
    let hit = chrome.paint_toolbar(ui, atlas, pal3, ox, oy, cw, ch, s, mx, my, down, page_click,
        chrome.PAGE_ARRAY);
    let _msg = pal3.paint_menu_message(ui, click, ox, oy, s);
    if hit == chrome.TOOLBAR_EXIT { return CLOSE; }
    if hit == chrome.PAGE_STATE { return TO_STATE; }
    if hit == chrome.PAGE_PROP { return TO_PROP; }
    if hit == chrome.PAGE_EQUIP { return TO_EQUIP; }
    if hit == chrome.PAGE_MAGIC { return TO_MAGIC; }
    if hit == chrome.PAGE_SWORD { return TO_SWORD; }
    if hit == chrome.PAGE_BOOK { return TO_BOOK; }
    if hit == chrome.PAGE_SYSTEM { return TO_SYSTEM; }

    return 1;
}

fn name_of(role: int) -> string {
    if role >= 0 && role < 5 { return ROLE_NAME[role]; }
    return "";
}
