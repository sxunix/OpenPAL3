// PAL3 in-game 御剑 (magic sword) page — standalone overlay, reached from
// any other full-screen page's toolbar.
//
// The page body lives in Rust (`IPal3Service::paint_sword_page`,
// yaobow/src/openpal3/sword_page.rs), following the original's source
// `gamemainui/swordui.cpp` (exe page init `FUN_004ab6b0`): the sword remark
// panel that slides out from under the sword frame, the current element's
// icon and weapon-skill name, the 3D sword and 龙精石, the 五灵 control
// panel (a 阴 and a 阳 button per block, `_over` once purified, `_perfect`
// once both faces are), the 阴/阳 turn button, 御剑飞行, and the whole
// purification screen with its dialogs. This script draws what every page
// shares — the frame line, the time/money plate and the toolbar.
//
// While the purification screen or a dialog is up the original refuses
// every toolbar button (`m_CanCtrlBtn` false → wa004); so does this page.
// Notes: switch/re/notes/sword_page_layout.md.

import radiance;
import shared.openpal3;
import radiance_scripting.ui as gui;
import yaobow.openpal3.menu_chrome as chrome;

pub let CLOSE: int = -1;
pub let TO_STATE: int = -2;
pub let TO_SYSTEM: int = -3;
pub let TO_PROP: int = -4;
pub let TO_EQUIP: int = -5;
pub let TO_MAGIC: int = -6;
pub let TO_ARRAY: int = -7;
pub let TO_BOOK: int = -8;

// `paint_sword_page` flags.
let LOCKED: int = 1;
let FLY: int = 2;

pub fn paint_sword_menu(
    ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
    mx: float, my: float, down: bool, click: bool, state: int,
) -> int {
    let lw = ui.display_size_x() as float;
    let lh = ui.display_size_y() as float;
    if lw <= 0.0 || lh <= 0.0 { return state; }

    let viewport = gui.Rect(0.0, 0.0, lw, lh);
    let native = gui.Size(chrome.REF_W, chrome.REF_H);
    let canvas = viewport.fit(native);
    let s = viewport.fit_scale(native);
    let cw = canvas.w;
    let ch = canvas.h;
    let ox = canvas.x;
    let oy = canvas.y;

    ui.fill_rect(0.0, 0.0, lw, lh, 0.0, 0.0, 0.0, 0.8);

    // No party plates on this page — the right edge is the 五灵 panel.
    chrome.sprite(ui, atlas, chrome.SPR_FRAME_LINE,
        ox + chrome.FRL_X * s, oy + chrome.FRL_Y * s, s);
    chrome.sprite(ui, atlas, chrome.SPR_TIMEMONEY, ox + chrome.TM_X * s, oy + chrome.TM_Y * s, s);
    chrome.widget_text(ui, ox + chrome.MONEY_X * s, oy + chrome.MONEY_Y * s, 0.0, s,
        1.0, 0.95, 0.5, chrome.int_str(pal3.money()));
    chrome.widget_text(ui, ox + chrome.TIME_X * s, oy + chrome.TIME_Y * s, 0.0, s,
        0.85, 1.0, 0.95, chrome.time_str(pal3.play_time()));

    let flags = pal3.paint_sword_page(ui, mx, my, down, click, ox, oy, s);
    let fly = (flags / FLY) % 2 == 1;
    if fly { return CLOSE; }
    let locked = flags % 2 == LOCKED;

    // ---- Bottom action toolbar -------------------------------------------
    if locked {
        // Drawn, but every button refuses.
        let _none = chrome.paint_toolbar(ui, atlas, pal3, ox, oy, cw, ch, s, mx, my, down, false,
            chrome.PAGE_SWORD);
        if click && my >= oy + chrome.TB_Y * s { pal3.ui_sound(chrome.SND_REFUSE); }
        return 0;
    }
    let hit = chrome.paint_toolbar(ui, atlas, pal3, ox, oy, cw, ch, s, mx, my, down, click,
        chrome.PAGE_SWORD);
    if hit == chrome.TOOLBAR_EXIT { return CLOSE; }
    if hit == chrome.PAGE_STATE { return TO_STATE; }
    if hit == chrome.PAGE_PROP { return TO_PROP; }
    if hit == chrome.PAGE_EQUIP { return TO_EQUIP; }
    if hit == chrome.PAGE_MAGIC { return TO_MAGIC; }
    if hit == chrome.PAGE_ARRAY { return TO_ARRAY; }
    if hit == chrome.PAGE_BOOK { return TO_BOOK; }
    if hit == chrome.PAGE_SYSTEM { return TO_SYSTEM; }
    return 0;
}
