// PAL3 in-game 系统 (system) page — standalone overlay, reached from any
// other full-screen page's toolbar, or straight from a save point.
//
// The page body lives in Rust (`IPal3Service::paint_system_page`,
// yaobow/src/openpal3/system_page.rs), following the original's source
// `gamemainui/SystemUI.cpp`: the 36 save notes (five showing, scrolled by
// the pgup/pgdw keys, the slider and the wheel), the 储存进度/读取进度
// push buttons, the 音乐/音效 bars, 离开游戏 and the dialogs. This script
// draws the dimmed backdrop and the toolbar.
//
// State: 0 or 1 = the page has just opened (1 = from a save point; the
// service's `can_save` already knows), OPENED while it runs; the TO_*
// values switch page, CLOSE shuts the menu (a load went ahead, or the
// game goes back to the title). While a dialog is up the toolbar does
// nothing (`OnMessage` returns early on a modal dialog).

import radiance;
import shared.openpal3;
import radiance_scripting.ui as gui;
import yaobow.openpal3.menu_chrome as chrome;

pub let CLOSE: int = -1;
pub let TO_STATE: int = -2;
pub let TO_PROP: int = -4;
pub let TO_EQUIP: int = -5;
pub let TO_MAGIC: int = -6;
pub let TO_ARRAY: int = -7;
pub let TO_BOOK: int = -8;
pub let TO_SWORD: int = -9;
let OPENED: int = 2;

// `paint_system_page` flags.
let LOCKED: int = 1;
let SHUT: int = 2;

pub fn paint_system_menu(
    ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
    mx: float, my: float, down: bool, click: bool, state: int,
) -> int {
    let lw = ui.display_size_x() as float;
    let lh = ui.display_size_y() as float;
    if lw <= 0.0 || lh <= 0.0 { return state; }

    let viewport = gui.Rect(0.0, 0.0, lw, lh);
    let native = gui.Size(chrome.REF_W, chrome.REF_H);
    let canvas = viewport.fit(native);
    let s = viewport.fit_scale(native);
    let cw = canvas.w;
    let ch = canvas.h;
    let ox = canvas.x;
    let oy = canvas.y;

    ui.fill_rect(0.0, 0.0, lw, lh, 0.0, 0.0, 0.0, 0.8);

    let fresh = state != OPENED;
    let flags = pal3.paint_system_page(ui, mx, my, down, click, ox, oy, s, fresh);
    if (flags / SHUT) % 2 == 1 { return CLOSE; }
    let locked = flags % 2 == LOCKED;

    // ---- Bottom action toolbar -------------------------------------------
    let hit = chrome.paint_toolbar(ui, atlas, pal3, ox, oy, cw, ch, s, mx, my, down,
        click && !locked, chrome.PAGE_SYSTEM);
    if hit == chrome.TOOLBAR_EXIT { return CLOSE; }
    if hit == chrome.PAGE_STATE { return TO_STATE; }
    if hit == chrome.PAGE_PROP { return TO_PROP; }
    if hit == chrome.PAGE_EQUIP { return TO_EQUIP; }
    if hit == chrome.PAGE_MAGIC { return TO_MAGIC; }
    if hit == chrome.PAGE_ARRAY { return TO_ARRAY; }
    if hit == chrome.PAGE_SWORD { return TO_SWORD; }
    if hit == chrome.PAGE_BOOK { return TO_BOOK; }
    return OPENED;
}
