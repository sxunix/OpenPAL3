// PAL3 in-game character-status (状态) menu — standalone overlay.
//
// Opened from the top-right HUD avatar (status_ui.p7) or via the agent
// server (`POST /v1/menu/status {"open":true}` -> IPal3StatusRenderer
// .set_menu_open).
//
// Composed entirely from PAL3's `UI_opt.tli` atlas (resolved by name
// through `IPal3UiAtlas`).
//
// Geometry comes from the original PAL3.exe (v1.4) state page code —
// FUN_004a4220 (page), FUN_004a26d0 (toolbar), FUN_004a4c20 (arrange),
// FUN_004a3730 (head plate), FUN_004a3360 (portrait panel); see
// 仙剑奇侠传3/re/notes/state_page_layout.md. Two rules from that code shape
// everything below:
//   * a widget's rect is only a placement point + hit area: the sprite is
//     drawn at its NATIVE size anchored at the rect's top-left, never
//     stretched into the rect;
//   * widget text uses the 16 px font, an 8 px inner margin on all sides,
//     8 px per ASCII byte / 16 px per CJK char, 16 px line pitch, and
//     wraps at the rect's right margin. The glyph row's bottom sits at
//     rect.y + 8 + 16 — see menu_chrome.p7.
// All native sizes are PAL3's 800x600 reference; `s = fit scale`.
//
// Stats are placeholders for the lead (景天) — the party/stat model is not
// yet threaded into p7. Returns whether the menu should stay open
// (false = the exit button dismissed it).

import radiance;
import shared.openpal3;
// Used for its geometry primitives (`Rect.fit`) only — this screen is still
// painted imperatively rather than as an `Element` tree.
import radiance_scripting.ui as gui;
// Frame + toolbar + text helpers shared with the other in-game pages.
import yaobow.openpal3.menu_chrome as chrome;

// --- Native (800x600) layout constants -----------------------------------
// The whole menu is authored in PAL3's native 800x600 (4:3) space and
// drawn into a CENTERED, LETTERBOXED 4:3 canvas, with a full-screen
// semi-transparent dim behind it (covering both the canvas and the
// margins), so the panels keep their original aspect and relative
// positions regardless of the display aspect ratio.

// Widget text: 16 px font, 8 px inner margin, 16 px line pitch.

// Left character panel base rect (0,0,148,530); Shade.tga is 149x530.
let LP_X: float = 0.0;
let LP_Y: float = 0.0;
let LP_STEP: float = 148.0;       // next party member's panel.
let SHADE_W: float = 149.0;
let SHADE_H: float = 530.0;

// Standing portrait: x 10..138; y 30..318 for most roles (Portrait0 is
// 128x288), role 2 (龙葵) 32..315 (130x283), role 4 (长卿) 16..317 (128x301).
let POR_X: float = 10.0;

// 五行 value text rects (150x32 each, panel-local). The exe hands the
// widget rect's top-left; the glyph's top-left is +8,+8 from it.
let WX_SHUI_X: float = 63.0;  let WX_SHUI_Y: float = 335.0;
let WX_HUO_X: float  = 113.0; let WX_HUO_Y: float  = 370.0;
let WX_FENG_X: float = 36.0;  let WX_FENG_Y: float = 420.0;
let WX_LEI_X: float  = 95.0;  let WX_LEI_Y: float  = 420.0;
let WX_TU_X: float   = 17.0;  let WX_TU_Y: float   = 370.0;

// 等级 rect (106,3,138,141): 32 wide minus margins leaves one CJK char per
// line, which is how the original gets vertical text.
let LV_X: float = 106.0; let LV_Y: float = 3.0;
// Experience rects (10,444,148,508) and (10,480,148,544): "%s\n  %d" —
// label line, then the value indented by two spaces (16 px).
let EXP_X: float = 10.0;
let EXP1_Y: float = 444.0;
let EXP2_Y: float = 480.0;
let EXP_VAL_INDENT: float = 16.0;

// Money / time text widget rects (absolute): (618,-4,738,28), (668,16,748,48).

// Bottom toolbar: StpBarL (0,543)-(256,600), StpBarM to 768, StpBarR to 800;
// Effect.tga (256x54) at (0,546) between the bar and the buttons; eight
// 110x50 buttons at x0 = 38 + 88n, y 546; hit rects (x0+35,551)-(x1-36,591).

// Empty party-member slots: NoBodyFrame (146x176) rects start right after
// the last present member's panel, (147,0) for a one-member party, then
// x += 148 until four columns are filled.
let NB_X0: float = 147.0;
let NB_STEP: float = 148.0;

// Head plate base rect (686,62,796,157) for the first member; the next
// member's plate is 122 lower. Plate-local offsets from FUN_004a3730:
// HeadBk at (x,y) (115x100 art), RoleHead at (x+25,y+10) (65x86), the
// vertical nameplate at (x2-27,y+36) (22x32).
let HB_X: float = 686.0; let HB_Y: float = 62.0; let HB_X2: float = 796.0;
// The arrange loop (FUN_004a4c20) tracks the plate cursor from y=60, so the
// first plate sits at 62 and every later one is 122 lower than the previous:
// 62, 182, 304, 426.
let HB_Y1: float = 182.0; let HB_STEP: float = 122.0;

// `IPal3Service::role_stat` selectors (see crosscom/idl/openpal3.idl).
let ST_LEVEL: int = 0;
let ST_EXP: int = 1;
let ST_EXP_NEXT: int = 2;
let ST_HP: int = 3;  let ST_MAX_HP: int = 4;
let ST_SP: int = 5;  let ST_MAX_SP: int = 6;
let ST_MP: int = 7;  let ST_MAX_MP: int = 8;
let ST_WATER: int = 9; let ST_FIRE: int = 10; let ST_WIND: int = 11;
let ST_THUNDER: int = 12; let ST_EARTH: int = 13;
let RH_DX: float = 25.0; let RH_DY: float = 10.0;
let NM_DX2: float = -27.0; let NM_DY: float = 36.0;
// 精/气/神 bars (Bar.tga 86x12 trough) at (x-72,y+21), (x-80,y+49),
// (x-70,y+77); their "cur/max" text rects at (x-70, y+28k) 100x32.
let BAR_J_DX: float = -72.0; let BAR_J_DY: float = 21.0;
let BAR_Q_DX: float = -80.0; let BAR_Q_DY: float = 49.0;
let BAR_S_DX: float = -70.0; let BAR_S_DY: float = 77.0;
let BAR_TXT_DX: float = -70.0; let BAR_TXT_STEP: float = 28.0;

// Right 状态 dragon panel: Frame.tga (195x526) at (592,18); Frame_Line
// (16x526) at (784,44); TimeMoney (204x64) at (596,0) over the frame top
// (its x1 is Frame_Line's x2 minus 0xcd; the item page uses the same rect).

// Exit button (Exit*.tga 37x48) at (762,549).

// --- Atlas sprite names (case-insensitive; resolved through the TLI) -----
let SPR_SHADE: string   = "ui/GameMainUI/State/Shade.tga";
let SPR_FRAME: string   = "ui/GameMainUI/State/Frame.tga";
let SPR_PORTRAIT: string = "ui/GameMainUI/State/Portrait";
let SPR_NOBODY: string  = "ui/GameMainUI/State/NoBodyFrame.tga";
let SPR_HEADBK: string  = "ui/GameMainUI/Communal/HeadBk.tga";
let SPR_ROLEHEAD: string = "ui/GameMainUI/Communal/RoleHead";
let SPR_BAR: string     = "ui/GameMainUI/Communal/Bar.tga";

// Compose the menu over the live scene + HUD. `mx`/`my` are the cursor,
// `click` is the left-button rising edge this frame.
// Returns 1 to stay open, 0 to close, 2 to switch to the system menu,
// 3 to the 道具 page, 4 to the 装备 page.
pub fn paint_state_menu(
    ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>,
    pal3: box<openpal3.IPal3Service>,
    mx: float, my: float, down: bool, click: bool,
) -> int {
    let lw = ui.display_size_x() as float;
    let lh = ui.display_size_y() as float;
    if lw <= 0.0 || lh <= 0.0 { return 1; }

    // Fit a 4:3 (800x600) canvas inside the window and centre it; the
    // leftover margins become black letterbox bars. `s` scales native px
    // to screen px; (ox, oy) is the canvas top-left in screen space.
    let viewport = gui.Rect(0.0, 0.0, lw, lh);
    let native = gui.Size(chrome.REF_W, chrome.REF_H);
    let canvas = viewport.fit(native);
    let s = viewport.fit_scale(native);
    let cw = canvas.w;
    let ch = canvas.h;
    let ox = canvas.x;
    let oy = canvas.y;

    // Dim the whole screen with a semi-transparent overlay (covers both
    // the menu's 4:3 area and the letterbox margins), so the live scene
    // reads as paused/behind the menu without hard black bars.
    ui.fill_rect(0.0, 0.0, lw, lh, 0.0, 0.0, 0.0, 0.8);

    // Live party from the running adventure. Falls back to a lone 景天
    // when there is none (the agent server can open this page from the
    // title screen). The original arranges at most four columns.
    let mut present = pal3.party_size();
    if present < 1 { present = 1; }
    if present > 4 { present = 4; }

    // ---- Left character panels, one per party member ---------------------
    let mut m = 0;
    while m < present {
        let role = role_at(pal3, m);
        let lp_x0 = ox + (LP_X + (m as float) * LP_STEP) * s;
        let lp_y0 = oy + LP_Y * s;
        chrome.sprite(ui, atlas, SPR_SHADE, lp_x0, lp_y0, s);
        chrome.sprite(ui, atlas, SPR_PORTRAIT + chrome.int_str(role) + ".tga",
            lp_x0 + POR_X * s, lp_y0 + portrait_top(role) * s, s);

        // Level: vertical Chinese numerals + 级, one character per line.
        let lv_txt = cn_num(pal3.role_stat(role, ST_LEVEL)) + "级";
        let lv_n = lv_txt.len_chars();
        let mut lv_i = 0;
        while lv_i < lv_n {
            let oc = lv_txt.char_at(lv_i);
            if oc != null {
                chrome.widget_text(ui, lp_x0 + LV_X * s, lp_y0 + LV_Y * s, (lv_i as float) * chrome.TXT, s,
                    0.1, 0.1, 0.1, oc!);
            }
            lv_i = lv_i + 1;
        }

        // 五行 values under the glyphs baked into Shade.
        chrome.widget_text(ui, lp_x0 + WX_SHUI_X * s, lp_y0 + WX_SHUI_Y * s, 0.0, s, 0.1, 0.1, 0.1,
            chrome.int_str(pal3.role_stat(role, ST_WATER)));
        chrome.widget_text(ui, lp_x0 + WX_HUO_X * s,  lp_y0 + WX_HUO_Y * s,  0.0, s, 0.1, 0.1, 0.1,
            chrome.int_str(pal3.role_stat(role, ST_FIRE)));
        chrome.widget_text(ui, lp_x0 + WX_FENG_X * s, lp_y0 + WX_FENG_Y * s, 0.0, s, 0.1, 0.1, 0.1,
            chrome.int_str(pal3.role_stat(role, ST_WIND)));
        chrome.widget_text(ui, lp_x0 + WX_LEI_X * s,  lp_y0 + WX_LEI_Y * s,  0.0, s, 0.1, 0.1, 0.1,
            chrome.int_str(pal3.role_stat(role, ST_THUNDER)));
        chrome.widget_text(ui, lp_x0 + WX_TU_X * s,   lp_y0 + WX_TU_Y * s,   0.0, s, 0.1, 0.1, 0.1,
            chrome.int_str(pal3.role_stat(role, ST_EARTH)));

        // Experience blocks: "%s\n  %d" — label, then the value on the next
        // line indented by two spaces. At level 99 the original swaps the
        // number for a string; we show a dash until that label is identified.
        let exp_next = pal3.role_stat(role, ST_EXP_NEXT);
        let mut exp_next_txt = chrome.int_str(exp_next);
        if exp_next < 0 { exp_next_txt = "-"; }
        chrome.widget_text(ui, lp_x0 + EXP_X * s, lp_y0 + EXP1_Y * s, 0.0, s, 0.1, 0.1, 0.1, "经验值");
        chrome.widget_text(ui, lp_x0 + (EXP_X + EXP_VAL_INDENT) * s, lp_y0 + EXP1_Y * s, chrome.TXT, s,
            0.1, 0.1, 0.1, chrome.int_str(pal3.role_stat(role, ST_EXP)));
        chrome.widget_text(ui, lp_x0 + EXP_X * s, lp_y0 + EXP2_Y * s, 0.0, s, 0.1, 0.1, 0.1, "升级所需经验值");
        chrome.widget_text(ui, lp_x0 + (EXP_X + EXP_VAL_INDENT) * s, lp_y0 + EXP2_Y * s, chrome.TXT, s,
            0.1, 0.1, 0.1, exp_next_txt);

        m = m + 1;
    }

    // ---- Empty party-member slots across the top ------------------------
    // Columns continue after the present members' panels, up to four.
    let mut col = present;
    let mut nb_x = NB_X0 + ((present - 1) as float) * NB_STEP;
    while col < 4 {
        chrome.sprite(ui, atlas, SPR_NOBODY, ox + nb_x * s, oy, s);
        nb_x = nb_x + NB_STEP;
        col = col + 1;
    }

    // ---- Right 状态 dragon panel + money/time ----------------------------
    chrome.paint_frame(ui, atlas, pal3, SPR_FRAME, ox, oy, s);

    // Head plate per party member: bars first (the plate's rim overlaps
    // their right ends), then HeadBk, the role head, and the nameplate.
    let mut h = 0;
    while h < present {
        let role = role_at(pal3, h);
        let hb_x = ox + HB_X * s;
        let hb_y = oy + head_row(h) * s;

        let jing_cur = pal3.role_stat(role, ST_HP);
        let jing_max = pal3.role_stat(role, ST_MAX_HP);
        let qi_cur = pal3.role_stat(role, ST_SP);
        let qi_max = pal3.role_stat(role, ST_MAX_SP);
        let shen_cur = pal3.role_stat(role, ST_MP);
        let shen_max = pal3.role_stat(role, ST_MAX_MP);

        draw_stat_bar(ui, atlas, "J", hb_x + BAR_J_DX * s, hb_y + BAR_J_DY * s, s, jing_cur, jing_max);
        draw_stat_bar(ui, atlas, "Q", hb_x + BAR_Q_DX * s, hb_y + BAR_Q_DY * s, s, qi_cur, qi_max);
        draw_stat_bar(ui, atlas, "S", hb_x + BAR_S_DX * s, hb_y + BAR_S_DY * s, s, shen_cur, shen_max);
        chrome.widget_text(ui, hb_x + BAR_TXT_DX * s, hb_y, 0.0, s, 0.15, 0.15, 0.15,
            chrome.int_str(jing_cur) + "/" + chrome.int_str(jing_max));
        chrome.widget_text(ui, hb_x + BAR_TXT_DX * s, hb_y + BAR_TXT_STEP * s, 0.0, s, 0.15, 0.15, 0.15,
            chrome.int_str(qi_cur) + "/" + chrome.int_str(qi_max));
        chrome.widget_text(ui, hb_x + BAR_TXT_DX * s, hb_y + BAR_TXT_STEP * 2.0 * s, 0.0, s, 0.15, 0.15, 0.15,
            chrome.int_str(shen_cur) + "/" + chrome.int_str(shen_max));
        chrome.sprite(ui, atlas, SPR_HEADBK, hb_x, hb_y, s);
        chrome.sprite(ui, atlas, SPR_ROLEHEAD + chrome.int_str(role) + "0.tga", hb_x + RH_DX * s, hb_y + RH_DY * s, s);
        chrome.sprite(ui, atlas, "ui/GameMainUI/Communal/" + name_tag(role) + "_name.tga",
            ox + (HB_X2 + NM_DX2) * s, hb_y + NM_DY * s, s);

        h = h + 1;
    }


    // ---- Bottom action toolbar -------------------------------------------
    let hit = chrome.paint_toolbar(ui, atlas, ox, oy, cw, ch, s, mx, my, down, click,
        chrome.PAGE_STATE);

    // The menu only closes via the exit button (no outside-click
    // dismissal) — clicks elsewhere are swallowed while it's open.
    if hit == chrome.TOOLBAR_EXIT { return 0; }
    if hit == chrome.PAGE_SYSTEM { return 2; }
    if hit == chrome.PAGE_PROP { return 3; }
    if hit == chrome.PAGE_EQUIP { return 4; }
    return 1;
}

// Portrait rect top for a role (FUN_004a3360): 龙葵's art is 283 tall and
// starts at 32, 长卿's is 301 tall and starts at 16, everyone else 288 at 30.
fn portrait_top(role: int) -> float {
    if role == 2 { return 32.0; }
    if role == 4 { return 16.0; }
    return 30.0;
}

// Nameplate sprite prefix per role (jt/xj/lk/zx/cq_name.tga).
fn name_tag(role: int) -> string {
    if role == 1 { return "xj"; }
    if role == 2 { return "lk"; }
    if role == 3 { return "zx"; }
    if role == 4 { return "cq"; }
    return "jt";
}

// 精/气/神 bar (x, y = trough top-left): Bar.tga trough, then the
// element's <L>_BarProgress fill from x+5, y+3, up to 80 px wide at full
// value (progress-bar insets 4/1/-4/-3 in FUN_0043fca0 / 0x4401de).
fn draw_stat_bar(ui: box<radiance.IUiHost>, atlas: box<openpal3.IPal3UiAtlas>, kind: string,
        x: float, y: float, s: float, cur: int, max: int) {
    chrome.sprite(ui, atlas, SPR_BAR, x, y, s);
    if max <= 0 { return; }
    let mut ratio = (cur as float) / (max as float);
    if ratio < 0.0 { ratio = 0.0; }
    if ratio > 1.0 { ratio = 1.0; }
    let osp = atlas.sprite("ui/GameMainUI/Communal/" + kind + "_BarProgress.tga");
    if osp == null { return; }
    let sp = osp!;
    let fx0 = x + 5.0 * s;
    let fy0 = y + 3.0 * s;
    let u1 = sp.u0() + (sp.u1() - sp.u0()) * ratio;
    ui.image_rect(sp.com_id(), fx0, fy0, fx0 + 80.0 * s * ratio, fy0 + (sp.height() as float) * s,
        sp.u0(), sp.v0(), u1, sp.v1());
}

// Level number as Chinese numerals (1..99 — the original's cap).
fn cn_num(n: int) -> string {
    if n <= 0 { return "零"; }
    if n < 10 { return cn_digit(n); }
    let tens = n / 10;
    let ones = n - tens * 10;
    let mut out: string = "";
    if tens > 1 { out = cn_digit(tens); }
    out = out + "十";
    if ones > 0 { out = out + cn_digit(ones); }
    return out;
}

fn cn_digit(d: int) -> string {
    if d == 1 { return "一"; } if d == 2 { return "二"; }
    if d == 3 { return "三"; } if d == 4 { return "四"; }
    if d == 5 { return "五"; } if d == 6 { return "六"; }
    if d == 7 { return "七"; } if d == 8 { return "八"; }
    return "九";
}

// stdlib-less integer -> decimal string.
// Actor id of the party member at `index`; 景天 (0) when the slot is empty
// so the page still draws something without a running adventure.
fn role_at(pal3: box<openpal3.IPal3Service>, index: int) -> int {
    let r = pal3.party_actor_id(index);
    if r < 0 { return 0; }
    return r;
}

// Head-plate y for the n-th party member: 62, then 122 apart (the arrange
// loop starts its cursor at 60, which is why the first gap is 120).
fn head_row(n: int) -> float {
    if n <= 0 { return HB_Y; }
    return HB_Y1 + ((n - 1) as float) * HB_STEP;
}
