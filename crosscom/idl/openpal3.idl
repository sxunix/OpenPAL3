// PAL3 launch service. Mirrors IPal4Service / ISwd5Service: a host-side
// COM object that knows how to construct a PAL3 director (asset manager,
// debug-layer install on the engine, MainMenuDirector). The director
// returned via `IDirector` is opaque to the script — the script just
// installs it on the scene manager (during normal play by returning it
// from update(), or during direct-boot from Rust via on_loading).
//
// Not marked `[protosept(scriptable)]` — the script only calls into it.
//
// The conforming `class Pal3Service` lives in `yaobow_services.idl`
// (and is implemented in `yaobow_lib`), not here, because the PAL3
// director construction lives in `yaobow_lib::openpal3` and pulling it
// into `shared` would require relocating four files. The interface
// itself lives here so `IPal3Service` can be referenced symmetrically
// from `IYaobowHostContext.pal3()`.
//
// `create_director(asset_path)` returns the **start-menu** director
// (script-built via `IPal3ScriptFactory::make_pal3_start_menu`). The
// menu's button handlers call back into this service to mint the
// adventure director (`create_adventure_director` / `load_adventure_director`)
// or to exit the app (`exit_app`).
[uuid(0c3ea732-4091-46a2-8ef1-79be6acaec77)]
interface IPal3Service: IUnknown {
    IDirector create_director(&str asset_path, int game_ordinal);

    // Construct the PAL3 main story (`AdventureDirector`) at a fresh
    // game state. The current scene is replaced and the OpenPAL3 init
    // script runs from the top. Returned director is what the menu
    // returns from its update() to swap itself out.
    IDirector create_adventure_director(&str asset_path);

    // Like `create_adventure_director`, but resumes from save slot
    // `slot` (1-based, matching `<save_dir>/OpenPAL3/Save/<slot>`).
    // Returns null when the slot is missing or fails to deserialize.
    IDirector? load_adventure_director(&str asset_path, int slot);

    // True when `<save_dir>/OpenPAL3/Save/<slot>` exists and the
    // current save loader accepts it. Drives whether the load-menu
    // overlay renders the slot as selectable.
    bool save_slot_exists(int slot);

    // Number of save slots surfaced by the save/load overlays. 36,
    // matching the original PC release ("仙3一次只支持36个存档" —
    // 9 pages of 4 scroll rows in the System page).
    int save_slot_count();

    // Paint the metadata line for save slot `slot` (scene + sub-scene
    // codes from the slot's persistent-state JSON) at (x, y) on `ui`'s
    // small game face. No-op when the slot is empty/corrupt. Lives on
    // the service because the script bridge cannot return strings.
    void draw_slot_label(IUiHost ui, int slot, float x, float y,
        float r, float g, float b, float a);

    // Save the ACTIVE adventure's persistent state into `slot` (1-based).
    // False when no adventure director is active or the slot is out of
    // range. Backs the in-game system menu's 存档 page.
    bool save_current(int slot);

    // Swap the active director for one resumed from `slot`, using the
    // last-launched asset path. False when the slot is missing/corrupt or
    // no PAL3 launch happened yet. Backs the system menu's 读取 page.
    bool request_load_slot(int slot);

    // 现在能不能存：不在迷宫（场景类型 2）、不在 m02，或者正从存盘点打开着存档页
    // （原版的 `DAT_005cefa9`）。系统页的「储存进度」按它放行。
    bool can_save();

    // 存盘点刚要打开系统页的存档（取走即清）。状态界面每帧问一次，是就开到存档。
    bool take_save_point_request();

    // 系统页关上：存盘点给的「能存」收回（原版关页时 `DAT_005cefa9` 换回打开前的值）。
    void leave_save_point();

    // Load the start-menu BGM from this asset path's game vfs and return
    // it as a generic `IAudioSource` the p7 menu holds and drives
    // (play/update/stop). PAL3 uses `PI01`, PAL3A uses `P01` (selected by
    // the game ordinal passed to `create_director`). Null when the
    // texture/audio engine isn't available or the track is missing.
    IAudioSource? load_menu_bgm(&str asset_path);

    // Forwarded to `IApplication::request_exit()` so the start menu's
    // "离开游戏" handler can quit without holding an `IApplication`
    // reference itself.
    void exit_app();

    // ---- Live party state, for the status screens ----
    //
    // These read the ACTIVE adventure's save state through a handle the
    // service keeps, so they are safe to call while painting from inside
    // the director's own update (unlike anything that touches the
    // director itself). All return 0 when no adventure is running.

    // Party members currently in the team, leader first.
    int party_size();

    // Actor id of the party member at `index` (0-based), or -1.
    int party_actor_id(int index);

    // One numeric stat of one character. `stat` selects the field:
    // 0 级 · 1 经验值 · 2 升级所需经验值 (-1 at level 99) ·
    // 3/4 精 cur/max · 5/6 气 cur/max · 7/8 神 cur/max ·
    // 9 水 10 火 11 风 12 雷 13 土 · 14 武 15 防 16 速 17 运.
    // Returns 0 for an unknown actor or selector.
    int role_stat(int actor_id, int stat);

    // 右上角头像那一块（`UISceneFace`）：受控主角的编号（0..4），没在冒险里是 0。
    int controlled_role();

    // 受控主角现在中的毒：0 风 1 雷 2 水 3 火 4 土，不中毒是 -1。
    int poison_kind();

    // 0 号角色身上的冒险状态 27..30（辟邪/退魔/神眼/精进），按位 0..3。
    int leader_field_states();

    // 这些状态的 60 秒计时器（`DAT_00c10cd0`）走了多少秒。
    float field_state_time();

    // 金钱.
    int money();

    // Elapsed play time in whole seconds — the status page's clock.
    // Integer because the script language has no float→int cast.
    int play_time();

    // ---- Inventory, for the 道具 page ----
    //
    // `type_mask` filters by item type: bit N selects `ItemType` N
    // (1 治疗 · 2 投掷 · 3 仙宝 · 4 古董 · 5 矿石 · 6 剧情 · 7 衣服 ·
    // 8 帽子 · 9 鞋子 · 10 饰品 · 11 武器 · 12 尸块). Pass -1 for every
    // type. Stacks are listed in ascending item id.

    // Number of distinct item stacks matching `type_mask`.
    int inventory_size(int type_mask);

    // Item id of the `index`-th matching stack, or -1.
    int inventory_item_id(int type_mask, int index);

    // How many of `item_id` are held.
    int item_count(int item_id);

    // One numeric field of an item's database row. `field` selects:
    // 0 类型 · 1 武器类型 · 2 价格 · 3 古董价值 · 4 使用地点 ·
    // 5 目标范围 · 6 特殊类型 ·
    // 7 炼制所需矿石ID · 8 炼制产物ID · 9 炼制产物价格 ·
    // 10 合成材料一 · 11 合成材料二 · 12 合成产物ID ·
    // 13 连击次数. 0 for an unknown item or field.
    int item_info(int item_id, int field);

    // Draw an item's name / description. Like `draw_slot_label`, these
    // paint rather than return because the script bridge cannot marshal
    // string returns. `wrap_px` is the text area's width in the same
    // units as `size`; the description wraps on it the way the original
    // widget does (ASCII advances half a cell, CJK a full cell), breaks
    // on `\n`, and starts a new line at the `$` that separates an item's
    // flavour text from its stat line.
    void draw_item_name(IUiHost ui, int item_id, float x, float y,
        float size, float r, float g, float b, float a);
    void draw_item_description(IUiHost ui, int item_id, float x, float y,
        float size, float wrap_px, float r, float g, float b, float a);

    // Just the stat line — what follows the `$` in the description, e.g.
    // "防+28 速-1". The 装备 page's slot rows show this rather than the
    // item's name. Draws nothing when the item has no stat line.
    void draw_item_stat_line(IUiHost ui, int item_id, float x, float y,
        float size, float r, float g, float b, float a);

    // ---- 用道具，for the 道具 page ----
    //
    // The rules live in `shared`'s `states::item_use`, one function per
    // original: `FUN_0049ca70` (可用) · `FUN_0049c660` (默认目标) ·
    // `FUN_0049cf80` (施用). The scene-side facts they need — 迷宫与否、
    // 当前城市是不是 M22、当前 `.sce` 有没有过程 2101、场景里有没有搜宝鼠
    // 找得到的东西 — are cached once a frame by the service, since the
    // menu paints from inside the director's update and can't reach the
    // scene itself.

    // Whether this character can take this item right now.
    bool item_usable(int item_id, int actor_id);

    // Who the arrow lands on when a row is clicked: >= 0 一个角色 id ·
    // -1 全体（range 2）· -2 队里没人需要 · -3 这件东西不能这么用。
    int item_use_target(int item_id);

    // Whether `NeedArrow` belongs over this character's head plate.
    bool item_use_arrow(int item_id, int actor_id);

    // Use one. Returns: 0 没用成 · 1 用了，菜单留着 · 2 用了并且要关菜单
    // （引路蜂/土灵珠跑过程、搜宝鼠）· 3 学会了仙术 · 4 升了一级.
    int use_item(int item_id, int actor_id);

    // 连用: stock left and someone in the party still needs it.
    bool item_use_can_continue(int item_id);

    // ---- Equipment, for the 装备 page ----
    //
    // Six slots per character: 0 帽 · 1 衣 · 2 鞋 · 3 饰品一 ·
    // 4 饰品二 · 5 武器.

    // Item id worn in `slot`, or -1 when the slot is empty.
    int equipped_item(int actor_id, int slot);

    // Wear an item out of the inventory, putting whatever it displaces
    // back there — what the original does. False when the character
    // doesn't hold the item, the item isn't equipment, or the id is
    // unknown.
    bool equip_item(int actor_id, int item_id);

    // Take a slot's piece off, back into the inventory. False when the
    // slot was empty.
    bool unequip_slot(int actor_id, int slot);

    // ---- Skills, for the 仙术 page ----

    // How many skills this character has learned.
    int skill_count(int actor_id);

    // The `index`-th learned skill id, in the order they were learned,
    // or -1.
    int skill_id(int actor_id, int index);

    // One numeric field of a skill's database row. `field` selects:
    // 0 类型 (SkillType) · 1 等级 · 2 消耗气 · 3 消耗神 ·
    // 4 成功率档 · 5 五灵掩码 (bit 0 水 … bit 4 土) ·
    // 6 所需角色等级 · 7 可否战斗外使用 · 8 下一级法术ID ·
    // 9 目标范围 · 10 本级法术等级 ·
    // 11 升级前还需使用次数 (at the skill's current level).
    // 0 for an unknown skill or field.
    int skill_info(int skill_id, int field);

    // Draw a skill's name / description, for the same reason the item
    // ones paint rather than return.
    void draw_skill_name(IUiHost ui, int skill_id, float x, float y,
        float size, float r, float g, float b, float a);
    void draw_skill_description(IUiHost ui, int skill_id, float x, float y,
        float size, float wrap_px, float r, float g, float b, float a);

    // ---- Combat actors, for the 侠义榜 ----
    //
    // The database's combat-actor table holds the playable characters
    // first and then every monster.

    // How many rows the table has.
    int combat_actor_count();

    // The `index`-th row's id, or -1.
    int combat_actor_id_at(int index);

    // One numeric field of a combat actor's row. `field` selects:
    // 0 类型 (CombatActorType) · 1 等级 · 2 精 · 3 气 · 4 神 ·
    // 5 武 · 6 防 · 7 速 · 8 运 · 9..13 五灵 水火风雷土 ·
    // 14 经验 · 15 被击败时可得钱 · 16 普通战利品ID ·
    // 17 普通战利品数量 · 18 可偷物品ID · 19 可偷钱数 ·
    // 20 尸块ID. 0 for an unknown actor or field.
    int combat_actor_info(int actor_id, int field);

    // Draw a 3D view (the original's 3D view control, `FUN_00439030`) over
    // the 800x600 canvas at (ox, oy) scaled by `scale`. `model` is a
    // basedata-relative `.pol`/`.cvd` path, `actor:<id>` for a combat
    // actor's model playing its idle action, or a bare role name. Camera:
    // ortho half-width `size` looking at screen point (look_x, look_y) —
    // `frontal` picks `FUN_00439850` (straight on) over `FUN_00439930`
    // (tilted down from 600). `yaw` in degrees. `mode` 0 hold / 1 once /
    // 2 loop at `speed`; the animation restarts whenever `serial` changes.
    // Views are cached by `key` and rebuilt when `model` changes. Returns
    // whether a once-played animation has finished.
    bool draw_model_view(IUiHost ui, int key, &str model, float size,
        float look_x, float look_y, float yaw, bool frontal, int mode,
        float speed, int serial, float ox, float oy, float scale);

    // Turn the 3D view under `key` about Y at `deg_per_sec` (0 stops) —
    // `FUN_0043a090(1, 0)`: the 道具 / 装备 page previews spin at the 98°/s
    // the control is built with, wrapping to 0 past 359°. Call it after
    // `draw_model_view`; the angle survives a model change, as in the
    // original.
    void spin_model_view(int key, float deg_per_sec);

    void draw_combat_actor_name(IUiHost ui, int actor_id, float x, float y,
        float size, float r, float g, float b, float a);
    void draw_combat_actor_description(IUiHost ui, int actor_id, float x,
        float y, float size, float wrap_px,
        float r, float g, float b, float a);

    // ---- 阵法 (五灵 formation) ----

    // 阵法页的 3D 五灵盘（wl.pol、在队角色、空站位上的指针），画满 800x600 画布；
    // 鼠标按住在盘上上下拖改俯角。
    void draw_lineup_disc(IUiHost ui, float mx, float my, bool down, float ox, float oy,
        float scale);

    // The formation position (0..=4) this character stands in, or -1.
    int lineup_position(int actor_id);

    // Which character stands in `position`, or -1.
    int lineup_occupant(int position);

    // Move a character into a position, evicting whoever stood there.
    bool set_lineup_position(int actor_id, int position);

    // 阵法页刚打开：照原版从角色记录重读站位（格 2、3 对调，见
    // `PersistentState::reread_lineup_for_page`）。
    void lineup_page_opened();

    // ---- 御剑页「御剑飞行」（`yjfx`，0xa00571） ----
    // 按钮显不显示：opcode 138 开的标志（`DAT_00de625a`）。
    bool sword_flight_unlocked();
    // 点了按钮（exe 0x4ae65e）：能飞就放 wa001、记下关菜单后开大地图，返回 0；
    // 不能飞放 wa003，返回要弹的 AssisLang 条号（迷宫 373、鬼界外围 108）。
    int fly_sword();
    // 画 `AssisLang.lang` 第 `index` 条（读法同 `FUN_00457410`）。
    void draw_lang_text(IUiHost ui, int index, float x, float y, float size,
        float r, float g, float b, float a);

    // Whether this monster has been recorded in the 侠义榜, and the
    // number recorded so far. Nothing marks monsters yet — that happens
    // when combat exists — so today these report an empty book.
    bool monster_seen(int actor_id);
    int monsters_seen_count();


    // Build a `IVideoHandle` playing `LOGO.bik` (loaded from the
    // per-launch vfs via `AssetManager::load_movie_data`). Returns
    // `null` after the first successful call per process — the
    // service tracks an `intro_played` latch so re-entry into the
    // menu (e.g. exit-to-menu from a future Adventure flow) skips
    // the intro. The p7 menu director renders the resulting handle
    // full-canvas until `state() == Stopped` or Esc is pressed.
    IVideoHandle? play_intro_movie(&str asset_path);

    // Build a generic, game-vfs-bound sprite loader (`ISpriteService`)
    // over this asset path's PAL3 vfs + the shared texture cache. The
    // returned handle is the north-star replacement for the bespoke
    // per-screen sprite accessors: callers `load_sprite` / build a
    // `IPal3UiAtlas` from it and compose UIs from generic `ISprite`
    // handles. Null when the texture cache isn't installed or the vfs
    // can't mount.
    ISpriteService? create_sprite_service(&str asset_path);

    // Build a PAL3 UI-atlas adapter over `ui\\UILib\\UI_opt.tli`: a
    // reusable format adapter (not a per-screen object) that resolves a
    // sprite *name* to a generic `ISprite` carved from the atlas page
    // that backs it, loading + caching each page once on demand. The p7
    // start menu composes itself by name through this. Null when the
    // manifest is missing or the texture cache isn't installed.
    IPal3UiAtlas? create_ui_atlas(&str asset_path);
}

// PAL3 UI-atlas adapter — bridges the PAL3-specific `UI_opt.tli` atlas
// manifest to the generic `ISprite` layer. Sprite names are the logical
// paths from the manifest, looked up case-insensitively with either
// `\\` or `/` separators (so both `ui\\Menu\\beijing.tga` and
// `ui/menu/beijing.tga` resolve to the same record). `has_sprite`
// reports presence so callers degrade gracefully.
//
// `native_width`/`native_height` describe the 800×600 canvas the
// original cover art was authored against; the p7 director letterboxes
// it into the framebuffer.
//
// This is a *format adapter*, reusable by any PAL3 screen that uses
// `UI_opt.tli` — distinct from the retired per-screen scene objects.
[uuid(c3aea9e0-db66-47b9-96a6-38bfb741dd23)]
interface IPal3UiAtlas: IUnknown {
    bool has_sprite(&str name);
    // Resolve `name` to a freshly-minted `ISprite` over the backing
    // atlas page (loaded + cached on first use). Callers cache the
    // result; null when the name is unknown or its page failed to load.
    ISprite? sprite(&str name);
    int native_width();
    int native_height();
}

[uuid(6ff64959-fd49-4db3-b1e4-2505bbc88114)]
class Pal3UiAtlas: IPal3UiAtlas {}

// Scripted, self-contained PAL3 in-game dialog-box renderer. A
// `[protosept(scriptable)]` interface implemented by a p7 struct,
// invoked from Rust at the exact points the legacy Rust `DialogBox`
// was driven inside the SCE command loop.
//
// Unlike the retired host-side `Pal3DialogBoxScene`, the renderer owns
// ALL of its state in p7: it is built with a generic `ISpriteService`
// (from which it `load_sprite`s its 9-slice chrome + decoration +
// click-indicator once and caches the com_id/size of each), loads the
// avatar portrait on demand, and holds the avatar side + curtain value
// as plain script fields. The host only forwards SCE events
// (`set_avatar` / `clear_avatar` / `set_curtain`) and the per-frame
// `render_dialog` / `render_curtain` draw calls.
//
// `set_avatar` resolves the portrait path as `ROLE/<role>/<face>.tga`;
// `side`: 0 = left (mirrored), 1 = right. `curtain` in [-1, 1]:
// magnitude is the fade opacity, sign selects the colour (>= 0 fades to
// black, < 0 to white); 0 = no fade.
[uuid(43092151-4d36-4f85-8268-51aaa24386fc), protosept(scriptable)]
interface IPal3DialogRenderer: IUnknown {
    // Compose the dialog panel (chrome + avatar + click indicator +
    // text) for the current frame. `text` is the markup-bearing dialog
    // string (`\i`/`\r` colour runs, `\n` line breaks); `dt` advances
    // the indicator blink.
    void render_dialog(IUiHost ui, &str text, float dt);

    // Paint the scene-transition curtain/fade for the current frame.
    void render_curtain(IUiHost ui);

    // SCE `dlgface`: set the portrait (loaded via the sprite service).
    void set_avatar(&str role, &str face, int side);
    // End of a `dlg` beat: drop the current portrait.
    void clear_avatar();
    // Set the curtain/fade level (see interface doc).
    void set_curtain(float value);
}

[uuid(c0373bc2-0823-4093-8f48-d42a076e8a4a)]
class Pal3DialogRenderer: IPal3DialogRenderer {}

// Scripted PAL3 in-game status indicator (top-right HUD). A
// `[protosept(scriptable)]` interface implemented by a p7 struct, drawn
// every frame the player has control (no SCE running). Owns all its
// state in p7: it `load_sprite`s the `ui/scene/face` panel art once
// (background `bk.tga`, the `hp.tga`/`mp.tga` gauges, and the team-lead
// avatar `face0` normal/hover/click variants) and holds the handles for
// its lifetime. HP/MP render full; the avatar swaps variant on
// mouse-over / mouse-down (decorative).
[uuid(7d4f0c2e-3b1a-4f5e-9c6d-2a8b1e74f9a0), protosept(scriptable)]
interface IPal3StatusRenderer: IUnknown {
    // Compose the top-right status panel (bk + hp/mp gauges + team-lead
    // avatar) for the current frame. `dt` advances any blink/timers.
    void render_status(IUiHost ui, float dt);

    // Open (`true`) or close (`false`) the full-screen character-status
    // (状态) menu overlay. Lets the agent server pop the menu without a
    // synthetic avatar click. Idempotent.
    void set_menu_open(bool open);

    // Open one full-screen menu page directly (the toolbar's page index:
    // 0 状态 · 1 道具 · 2 装备 · 3 仙术 · 4 阵法 · 5 御剑 · 6 侠义榜 · 7 系统),
    // closing whatever else is open. For the agent server; players reach
    // the pages through the toolbar.
    void set_menu_page(int page);

    // Whether the character-status menu overlay is currently open. The
    // adventure director reads this each frame to freeze the game world
    // (scene entity updates + world simulation) while the menu is up.
    bool is_menu_open();
}

[uuid(8e5a1d3f-4c2b-4061-ad7e-3b9c2f85fab1)]
class Pal3StatusRenderer: IPal3StatusRenderer {}

// Script-implemented factory for the PAL3 launch surface. The yaobow
// `app.p7` `YaobowScriptApp` conforms to this in addition to
// `IPal4ScriptFactory`; `Pal3Service::create_director` QI's the host
// app to this and calls `make_pal3_start_menu` straight through the
// COM vtable.
[uuid(210ea28f-d971-414b-9fba-d3e942cc0516), protosept(scriptable)]
interface IPal3ScriptFactory: IUnknown {
    // Scripted PAL3 start-menu director. Returns `IDirector` (the menu
    // struct conforms to both `IUiLayer` and `IDirector`); the engine
    // auto-bridges the active director to a UI layer by QI'ing `IUiLayer`.
    IDirector make_pal3_start_menu(&str asset_path);

    // Scripted PAL3 in-game dialog-box renderer, built with a generic
    // `ISpriteService` (game-vfs-bound) it loads its chrome/indicator
    // sprites through. `Pal3Service` builds one per adventure director
    // and threads it into the SCE command loop, which forwards
    // `set_avatar`/`set_curtain` events and the per-frame draw calls.
    IPal3DialogRenderer make_pal3_dialog_renderer(ISpriteService sprites);

    // Scripted PAL3 in-game status indicator, built with a generic
    // `ISpriteService` it loads its panel art through. Threaded into the
    // SCE command loop alongside the dialog renderer; drawn each frame
    // the player has control. The `IPal3UiAtlas` provides the in-game
    // menu (state) screen sprites the avatar click pops open.
    IPal3StatusRenderer make_pal3_status_renderer(ISpriteService sprites, IPal3UiAtlas atlas);
}

[uuid(4b76fb5a-25c0-4c83-9ed3-ffd5bf342856)]
class Pal3ScriptFactory: IPal3ScriptFactory {}

