diff --git a/p7/src/interpreter/context/struct_heap.rs b/p7/src/interpreter/context/struct_heap.rs
new file mode 100644
index 0000000..fd1cb96
--- /dev/null
+++ b/p7/src/interpreter/context/struct_heap.rs
@@ -0,0 +1,116 @@
+//! Slab storage for heap-allocated structs, collected by the GC.
+//!
+//! Structs used to live in a plain `Vec` that only ever grew: every
+//! `NewStruct` appended, nothing was freed, and the mark phase walked the
+//! whole vector as roots. A UI script that builds a few `Rect`s per frame
+//! therefore leaked memory and made every collection slower than the last
+//! (the PAL3 start menu went from 20 to 40 ms a frame in half a minute).
+//!
+//! Like [`super::box_heap::BoxHeap`], slots are stable and reused through a
+//! free list. `Data::StructRef` stays a single `u32`: the low
+//! [`IDX_BITS`] bits are the slot, the high bits a generation that is bumped
+//! on free, so a reference that outlived its struct fails on dereference
+//! instead of reading whatever was allocated in the slot next.
+
+use super::data::Struct;
+
+/// Slot bits of a packed struct reference; the rest is the generation.
+pub const IDX_BITS: u32 = 24;
+const IDX_MASK: u32 = (1 << IDX_BITS) - 1;
+const GEN_MASK: u32 = (1 << (32 - IDX_BITS)) - 1;
+
+pub fn pack(idx: u32, generation: u32) -> u32 {
+    (generation & GEN_MASK) << IDX_BITS | (idx & IDX_MASK)
+}
+
+pub fn unpack(r: u32) -> (u32, u32) {
+    (r & IDX_MASK, r >> IDX_BITS)
+}
+
+#[derive(Default)]
+pub struct StructHeap {
+    slots: Vec<Option<Struct>>,
+    gens: Vec<u32>,
+    free_list: Vec<u32>,
+    live_count: usize,
+}
+
+impl std::fmt::Debug for StructHeap {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("StructHeap")
+            .field("slots", &self.slots.len())
+            .field("live", &self.live_count)
+            .finish()
+    }
+}
+
+impl StructHeap {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Store `value` and return its packed reference.
+    pub fn alloc(&mut self, value: Struct) -> u32 {
+        self.live_count += 1;
+        if let Some(idx) = self.free_list.pop() {
+            self.slots[idx as usize] = Some(value);
+            pack(idx, self.gens[idx as usize])
+        } else {
+            let idx = self.slots.len() as u32;
+            assert!(idx <= IDX_MASK, "p7: struct heap exhausted");
+            self.slots.push(Some(value));
+            self.gens.push(0);
+            pack(idx, 0)
+        }
+    }
+
+    /// The live struct behind packed reference `r`, if it is still the
+    /// one `r` was minted for.
+    pub fn get(&self, r: u32) -> Option<&Struct> {
+        let (idx, generation) = unpack(r);
+        if self.gens.get(idx as usize)? & GEN_MASK != generation {
+            return None;
+        }
+        self.slots[idx as usize].as_ref()
+    }
+
+    pub fn get_mut(&mut self, r: u32) -> Option<&mut Struct> {
+        let (idx, generation) = unpack(r);
+        if self.gens.get(idx as usize)? & GEN_MASK != generation {
+            return None;
+        }
+        self.slots[idx as usize].as_mut()
+    }
+
+    /// Slot count, live or not (for error messages).
+    pub fn len(&self) -> usize {
+        self.slots.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.live_count == 0
+    }
+
+    pub fn live_count(&self) -> usize {
+        self.live_count
+    }
+
+    /// Indices of all live slots.
+    pub fn live_indices(&self) -> Vec<u32> {
+        self.slots
+            .iter()
+            .enumerate()
+            .filter_map(|(i, s)| s.as_ref().map(|_| i as u32))
+            .collect()
+    }
+
+    pub fn free(&mut self, idx: u32) {
+        let i = idx as usize;
+        if self.slots.get(i).is_some_and(Option::is_some) {
+            self.slots[i] = None;
+            self.gens[i] = self.gens[i].wrapping_add(1);
+            self.free_list.push(idx);
+            self.live_count -= 1;
+        }
+    }
+}
diff --git a/p7/tests/runtime_values.rs b/p7/tests/runtime_values.rs
index 006ba9e..63e439d 100644
--- a/p7/tests/runtime_values.rs
+++ b/p7/tests/runtime_values.rs
@@ -113,3 +113,39 @@ fn shared_nullable_payloads_clone_shallowly_but_compare_by_value() {
     let elements = inner.array_elements().expect("array payload");
     assert_eq!(elements, &[Data::string("value")]);
 }
+
+#[test]
+fn gc_collects_unreachable_structs_and_keeps_reachable_ones() {
+    use p7::interpreter::context::Struct;
+    let mut ctx = Context::new();
+    // A struct reached through a box that is reached through a root, and
+    // one nothing reaches.
+    let kept = ctx.heap.alloc(Struct {
+        fields: vec![Data::Int(1)],
+    });
+    let dropped = ctx.heap.alloc(Struct {
+        fields: vec![Data::Int(2)],
+    });
+    let (b, g) = ctx.box_heap.alloc(Data::StructRef(kept));
+    ctx.stack[0].stack.push(Data::BoxRef {
+        idx: b,
+        generation: g,
+    });
+
+    ctx.collect_garbage().expect("gc should run");
+
+    assert_eq!(
+        ctx.heap.get(kept).map(|s| s.fields.clone()),
+        Some(vec![Data::Int(1)])
+    );
+    assert!(ctx.heap.get(dropped).is_none());
+
+    // The freed slot is reused, and the old reference does not see the
+    // new occupant.
+    let reused = ctx.heap.alloc(Struct {
+        fields: vec![Data::Int(3)],
+    });
+    assert_ne!(reused, dropped);
+    assert!(ctx.heap.get(dropped).is_none());
+    assert_eq!(ctx.heap.live_count(), 2);
+}
